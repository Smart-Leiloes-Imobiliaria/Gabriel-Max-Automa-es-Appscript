const CEF_ATESTE_PROCESSED_PROP_PREFIX_ = 'CEF_ATESTE_GMAIL_PROCESSED_'
const CEF_ATESTE_ERROR_PROP_PREFIX_ = 'CEF_ATESTE_GMAIL_ERROR_'
const CEF_ATESTE_PROCESSED_LABEL_ = 'Automação-ateste-processada'
const CEF_ATESTE_THREAD_PAGE_SIZE_ = 50
const CEF_ATESTE_MAX_THREADS_PER_RUN_ = 500

const CEF_ATESTE_NUMERO_IMOVEL_FIELD_KEY_ = '5c3aac951d1281021e01c13aa7a11a449efeabd1'
const CEF_ATESTE_IPTU_DATA_FIELD_KEY_ = '1463f7080f9572cd2bf480362a1e917c008460e8'
const CEF_ATESTE_CONDOMINIO_DATA_FIELD_KEY_ = '0d9c4aab2ee0bd18d78fb1fd3b32f403f0642eb2'
const CEF_ATESTE_REL_IPTU_ = 'IPTU'
const CEF_ATESTE_REL_CONDOMINIO_ = 'CONDOMINIO'

function processarAtestesPagamentoCefDataPrimeiroAteste() {
  const summary = { scanned: 0, processed: 0, skipped: 0, errors: 0 }
  const seenMessages = {}
  const queries = cefAtesteBuildGmailQueries_()

  for (let q = 0; q < queries.length; q++) {
    const query = queries[q]
    for (let start = 0; start < CEF_ATESTE_MAX_THREADS_PER_RUN_; start += CEF_ATESTE_THREAD_PAGE_SIZE_) {
      const threads = GmailApp.search(query, start, CEF_ATESTE_THREAD_PAGE_SIZE_)
      if (!threads.length) break

      for (let i = 0; i < threads.length; i++) {
        const messages = threads[i].getMessages()
        for (let j = 0; j < messages.length; j++) {
          const message = messages[j]
          const messageId = String(message.getId() || '').trim()
          if (messageId && seenMessages[messageId]) continue
          if (messageId) seenMessages[messageId] = true

          summary.scanned++
          const result = processarMensagemAtestePagamentoCef_(message)
          if (result && result.ok && result.processed) summary.processed++
          else if (result && result.ok) summary.skipped++
          else summary.errors++
        }
      }
    }
  }

  return summary
}

function cefAtesteBuildGmailQueries_() {
  return [
    'subject:"Ateste de pagamento ID:" subject:"BEM:"',
    'subject:"ATESTE DE PAGAMENTO" subject:"BEM:"',
    '"Ateste de pagamento ID:" "BEM:"'
  ]
}

function instalarTriggerAtestesPagamentoCefDataPrimeiroAteste() {
  removerTriggerAtestesPagamentoCefDataPrimeiroAteste()
  ScriptApp.newTrigger('processarAtestesPagamentoCefDataPrimeiroAteste')
    .timeBased()
    .everyHours(2)
    .create()
}

function removerTriggerAtestesPagamentoCefDataPrimeiroAteste() {
  const triggers = ScriptApp.getProjectTriggers()
  for (let i = 0; i < triggers.length; i++) {
    if (String(triggers[i].getHandlerFunction() || '') === 'processarAtestesPagamentoCefDataPrimeiroAteste') {
      ScriptApp.deleteTrigger(triggers[i])
    }
  }
}

function diagnosticarAtestePagamentoCefEmailPorId(messageId) {
  const id = String(messageId || '').trim()
  if (!id) throw new Error('messageId vazio.')
  const message = GmailApp.getMessageById(id)
  if (!message) throw new Error('Mensagem Gmail não encontrada: ' + id)

  const subject = String(message.getSubject() || '')
  const from = String(message.getFrom() || '')
  const body = cefAtesteGetReadableBody_(message)
  const bem = cefAtesteExtractBemCode_(subject)
  const proponentePrimeiroNome = cefAtesteExtractProponentFirstName_(body)
  const despesa = cefAtesteExtractDespesa_(body)
  const classification = cefAtesteClassifyDespesa_(despesa)

  const summary = {
    messageId: id,
    subject: subject,
    from: from,
    date: message.getDate(),
    receivedDate: cefAtesteFormatDate_(message.getDate()),
    bem: bem,
    proponentePrimeiroNome: proponentePrimeiroNome,
    despesa: despesa,
    classification: classification,
    eligibleSubject: cefAtesteHasEntrySubject_(subject),
    hasCefSource: cefAtesteHasCefSource_(subject, from, body),
    bodyDebug: cefAtesteBuildBodyDebug_(message, body)
  }
  Logger.log(JSON.stringify(summary, null, 2))
  return summary
}

function testarFluxoRealAtestePagamentoCefEmailEspecifico() {
  const props = PropertiesService.getScriptProperties()
  const messageId = String(props.getProperty('CEF_ATESTE_TEST_MESSAGE_ID') || props.getProperty('CEF_DEVOLUTIVA_TEST_MESSAGE_ID') || '').trim()
  if (!messageId) throw new Error('Configure CEF_ATESTE_TEST_MESSAGE_ID nas Script Properties.')
  const message = GmailApp.getMessageById(messageId)
  if (!message) throw new Error('Mensagem Gmail não encontrada: ' + messageId)

  const diagnostico = diagnosticarAtestePagamentoCefEmailPorId(messageId)
  let processamento
  try {
    processamento = processarMensagemAtestePagamentoCef_(message)
  } catch (err) {
    processamento = { ok: false, error: String(err && err.message ? err.message : err) }
  }

  const result = {
    ok: processamento && processamento.ok === true,
    messageId: messageId,
    diagnostico: diagnostico,
    processamento: processamento
  }
  Logger.log(JSON.stringify(result, null, 2))
  return result
}

function processarMensagemAtestePagamentoCef_(message) {
  const messageId = String(message.getId() || '').trim()
  if (!messageId) return { ok: false, error: 'empty_message_id' }
  if (cefAtesteWasProcessedMessage_(message)) {
    if (!cefAtesteMessageHasProcessedLabel_(message)) cefAtesteMarkMessageProcessedLabel_(message)
    return { ok: true, skipped: 'already_processed' }
  }

  const subject = String(message.getSubject() || '')
  const from = String(message.getFrom() || '')
  const body = cefAtesteGetReadableBody_(message)

  if (!cefAtesteHasEntrySubject_(subject)) return { ok: true, skipped: 'missing_entry_subject' }
  if (!cefAtesteHasCefSource_(subject, from, body)) return { ok: true, skipped: 'missing_cef_source' }

  const bem = cefAtesteExtractBemCode_(subject)
  if (!bem) {
    cefAtesteMarkError_(messageId, 'bem_not_found')
    return { ok: false, error: 'bem_not_found' }
  }

  const proponentePrimeiroNome = cefAtesteExtractProponentFirstName_(body)
  if (!proponentePrimeiroNome) {
    cefAtesteMarkError_(messageId, 'proponent_first_name_not_found')
    return { ok: false, error: 'proponent_first_name_not_found', bem: bem }
  }

  const despesa = cefAtesteExtractDespesa_(body)
  const classification = cefAtesteClassifyDespesa_(despesa)
  if (!classification.valid) {
    cefAtesteMarkError_(messageId, classification.reason || 'invalid_despesa')
    return { ok: false, error: classification.reason || 'invalid_despesa', bem: bem, despesa: despesa }
  }

  if (!cefAtesteHasPipedriveConfig_()) {
    cefAtesteMarkError_(messageId, 'pipedrive_config_missing')
    return { ok: false, error: 'pipedrive_config_missing', bem: bem }
  }

  const deal = cefAtesteFindDealByBemAndFirstName_(bem, proponentePrimeiroNome)
  if (!deal || !deal.id) {
    cefAtesteMarkError_(messageId, 'deal_not_found_or_name_mismatch:' + bem + ':' + proponentePrimeiroNome)
    return { ok: false, error: 'deal_not_found_or_name_mismatch', bem: bem, proponentePrimeiroNome: proponentePrimeiroNome }
  }

  const patch = cefAtesteBuildDealPatch_(classification.relation, message.getDate())
  cefAtesteCallPipedrive_('deals/' + encodeURIComponent(String(deal.id)), 'PUT', patch)

  cefAtesteMarkProcessed_(messageId, {
    dealId: deal.id,
    bem: bem,
    proponentePrimeiroNome: proponentePrimeiroNome,
    relation: classification.relation,
    receivedDate: cefAtesteFormatDate_(message.getDate())
  }, message)

  cefAtesteLog_('SIM', deal.id, subject, 'processed', {
    messageId: messageId,
    bem: bem,
    proponentePrimeiroNome: proponentePrimeiroNome,
    despesa: despesa,
    relation: classification.relation,
    patch: patch
  })

  return {
    ok: true,
    processed: true,
    dealId: deal.id,
    dealTitle: deal.title || '',
    bem: bem,
    proponentePrimeiroNome: proponentePrimeiroNome,
    relation: classification.relation,
    receivedDate: cefAtesteFormatDate_(message.getDate()),
    patch: patch
  }
}

function cefAtesteHasEntrySubject_(subject) {
  const normalized = cefAtesteNormalize_(subject)
  return normalized.indexOf('ateste de pagamento id') >= 0 && /\bbem\b/.test(normalized)
}

function cefAtesteHasCefSource_(subject, from, body) {
  const text = cefAtesteNormalize_([subject, from, body].join('\n'))
  return /\bcef\b/.test(text) || text.indexOf('caixa') >= 0
}

function cefAtesteExtractBemCode_(subject) {
  const match = String(subject || '').match(/\bbem\s*[:\-]\s*([0-9][0-9.\-\/]{1,})/i)
  return match ? cefAtesteNormalizeCode_(match[1]) : ''
}

function cefAtesteExtractProponentFirstName_(body) {
  const text = String(body || '')
  const match = text.match(/smart\s+caixa\s+([A-ZÀ-Ý][A-ZÀ-Ý'´`^~-]*(?:\s+[A-ZÀ-Ý][A-ZÀ-Ý'´`^~-]*)*)/i)
  if (!match) return ''
  const ignored = { DA: true, DE: true, DO: true, DAS: true, DOS: true, E: true }
  const parts = String(match[1] || '').split(/\s+/)
  for (let i = 0; i < parts.length; i++) {
    const part = cefAtesteNormalize_(parts[i]).toUpperCase()
    if (part && !ignored[part]) return part
  }
  return ''
}

function cefAtesteExtractDespesa_(body) {
  const match = String(body || '').match(/(?:^|[\n\r])\s*despesa\s*[:\-]\s*([^\n\r]+)/i)
  return match ? String(match[1] || '').trim() : ''
}

function cefAtesteClassifyDespesa_(despesa) {
  const normalized = cefAtesteNormalize_(despesa)
  if (!normalized) return { valid: false, reason: 'despesa_not_found' }
  if (/\biptu\b/.test(normalized)) return { valid: true, relation: CEF_ATESTE_REL_IPTU_ }
  if (normalized.indexOf('condominio') >= 0 || normalized.indexOf('taxa condominial') >= 0) {
    return { valid: true, relation: CEF_ATESTE_REL_CONDOMINIO_ }
  }
  return { valid: false, reason: 'unsupported_despesa', despesa: despesa }
}

function cefAtesteBuildDealPatch_(relation, receivedAt) {
  const date = cefAtesteFormatDate_(receivedAt)
  const patch = {}
  if (relation === CEF_ATESTE_REL_IPTU_) {
    patch[CEF_ATESTE_IPTU_DATA_FIELD_KEY_] = date
    return patch
  }
  if (relation === CEF_ATESTE_REL_CONDOMINIO_) {
    patch[CEF_ATESTE_CONDOMINIO_DATA_FIELD_KEY_] = date
    return patch
  }
  throw new Error('Relação inválida para patch do ateste: ' + relation)
}

function cefAtesteFindDealByBemAndFirstName_(bem, firstName) {
  const code = cefAtesteNormalizeCode_(bem)
  const wantedFirstName = cefAtesteNormalize_(firstName)
  if (!code || !wantedFirstName) return null

  const attempts = [
    'deals/search?term=' + encodeURIComponent(code) + '&exact_match=1&fields=title,custom_fields&limit=20',
    'deals/search?term=' + encodeURIComponent(code) + '&fields=title,custom_fields&limit=50'
  ]

  for (let a = 0; a < attempts.length; a++) {
    const response = cefAtesteCallPipedrive_(attempts[a], 'GET', null) || {}
    const items = response && Array.isArray(response.items) ? response.items : []
    for (let i = 0; i < items.length; i++) {
      const item = items[i] && items[i].item ? items[i].item : (items[i] || {})
      const deal = item.id ? cefAtesteCallPipedrive_('deals/' + encodeURIComponent(String(item.id)), 'GET', null) : null
      if (!deal || !deal.id) continue
      if (!cefAtesteDealMatchesBem_(deal, item, code)) continue
      if (!cefAtesteTitleContainsFirstName_(deal.title || item.title || '', wantedFirstName)) continue
      return deal
    }
  }

  return null
}

function cefAtesteDealMatchesBem_(deal, item, code) {
  const dealCode = cefAtesteNormalizeCode_(cefAtesteGetDealFieldValue_(deal, CEF_ATESTE_NUMERO_IMOVEL_FIELD_KEY_))
  const titleCode = cefAtesteNormalizeCode_(deal.title || item.title || '')
  return dealCode === code || (titleCode && titleCode.indexOf(code) >= 0)
}

function cefAtesteTitleContainsFirstName_(title, firstName) {
  const normalizedTitle = cefAtesteNormalize_(title)
  const normalizedFirstName = cefAtesteNormalize_(firstName)
  if (!normalizedTitle || !normalizedFirstName) return false
  return new RegExp('(^|[^a-z0-9])' + cefAtesteEscapeRegExp_(normalizedFirstName) + '([^a-z0-9]|$)', 'i').test(normalizedTitle)
}

function cefAtesteGetDealFieldValue_(deal, fieldKey) {
  const key = String(fieldKey || '').trim()
  if (!deal || typeof deal !== 'object' || !key) return null
  if (Object.prototype.hasOwnProperty.call(deal, key)) return deal[key]
  const custom = deal.custom_fields && typeof deal.custom_fields === 'object' ? deal.custom_fields : null
  if (custom && Object.prototype.hasOwnProperty.call(custom, key)) return custom[key]
  return null
}

function cefAtesteHasPipedriveConfig_() {
  try {
    const cfg = cefAtesteGetPipedriveConfig_()
    return !!(cfg.baseUrl && cfg.token)
  } catch (_) {
    return false
  }
}

function cefAtesteGetPipedriveConfig_() {
  const props = PropertiesService.getScriptProperties()
  const token = String(
    props.getProperty('PIPEDRIVE_TOKEN') ||
    props.getProperty('PIPEDRIVE_API_TOKEN') ||
    props.getProperty('PD_API_KEY') ||
    ''
  ).trim()
  const domain = String(props.getProperty('PIPEDRIVE_DOMAIN') || '').trim()
  let baseUrl = String(
    props.getProperty('BASE_URL') ||
    props.getProperty('PIPEDRIVE_BASE_URL') ||
    props.getProperty('PD_BASE_URL') ||
    (domain ? domain : '') ||
    'https://api.pipedrive.com/v1'
  ).trim()

  if (!token) throw new Error('Falta PIPEDRIVE_TOKEN ou PIPEDRIVE_API_TOKEN nas Script Properties.')
  if (!baseUrl) throw new Error('Falta BASE_URL ou PIPEDRIVE_BASE_URL nas Script Properties.')

  return { baseUrl: cefAtesteNormalizePipedriveBaseUrl_(baseUrl), token: token }
}

function cefAtesteNormalizePipedriveBaseUrl_(baseUrl) {
  let url = String(baseUrl || '').trim().replace(/\/+$/, '')
  if (!url) return ''
  if (!/^https?:\/\//i.test(url)) {
    if (url.indexOf('/') >= 0 || /\.pipedrive\.com/i.test(url)) url = 'https://' + url
    else url = 'https://' + url + '.pipedrive.com'
  }
  url = url.replace(/\/api\/v1\/api\/v1$/i, '/api/v1')
  if (/^https?:\/\/api\.pipedrive\.com$/i.test(url)) url += '/v1'
  else if (/^https?:\/\/api\.pipedrive\.com\/v1$/i.test(url)) return url
  else if (/\.pipedrive\.com$/i.test(url)) url += '/api/v1'
  else if (/\.pipedrive\.com\/v1$/i.test(url)) url = url.replace(/\/v1$/i, '/api/v1')
  else if (/\.pipedrive\.com\/api$/i.test(url)) url += '/v1'
  else if (!/\/(?:api\/)?v1$/i.test(url)) url += '/v1'
  return url
}

function cefAtesteCallPipedrive_(endpoint, method, payload) {
  const cfg = cefAtesteGetPipedriveConfig_()
  const path = String(endpoint || '').trim().replace(/^\/+/, '')
  if (!path) throw new Error('Endpoint Pipedrive vazio.')

  const hasToken = /(^|[?&])api_token=/.test(path)
  const sep = path.indexOf('?') >= 0 ? '&' : '?'
  const url = cfg.baseUrl + '/' + path + (hasToken ? '' : sep + 'api_token=' + encodeURIComponent(cfg.token))
  const requestMethod = String(method || 'GET').toUpperCase()
  const options = { method: requestMethod, muteHttpExceptions: true }

  if (payload != null && requestMethod !== 'GET' && requestMethod !== 'DELETE') {
    options.contentType = 'application/json'
    options.payload = JSON.stringify(payload)
  }

  const response = UrlFetchApp.fetch(url, options)
  const status = response.getResponseCode()
  const text = response.getContentText()
  const data = text ? JSON.parse(text) : {}
  if (status < 200 || status >= 300 || data.success === false) {
    throw new Error('Erro Pipedrive ' + status + ': ' + text + ' | URL=' + cefAtesteRedactPipedriveUrl_(url))
  }
  return data && Object.prototype.hasOwnProperty.call(data, 'data') ? data.data : data
}

function cefAtesteRedactPipedriveUrl_(url) {
  return String(url || '').replace(/([?&]api_token=)[^&\s]+/gi, '$1[REDACTED]')
}

function cefAtesteGetReadableBody_(message) {
  const plain = String(message && message.getPlainBody ? (message.getPlainBody() || '') : '')
  const html = String(message && message.getBody ? (message.getBody() || '') : '')
  const htmlText = cefAtesteHtmlToReadableText_(html)
  if (!htmlText || cefAtesteNormalize_(plain).indexOf(cefAtesteNormalize_(htmlText)) >= 0) return plain
  if (!plain) return htmlText
  return plain + '\n' + htmlText
}

function cefAtesteHtmlToReadableText_(html) {
  return String(html || '')
    .replace(/<\s*br\s*\/?\s*>/gi, '\n')
    .replace(/<\s*\/\s*(p|div|h[1-6]|li|section|article)\s*>/gi, '\n')
    .replace(/<\s*\/\s*tr\s*>/gi, '\n')
    .replace(/<\s*\/\s*(td|th)\s*>/gi, '\t')
    .replace(/<\s*(tr|td|th)\b[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n[ \t]+/g, '\n')
    .replace(/[ \t]{2,}/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim()
}

function cefAtesteBuildBodyDebug_(message, readableBody) {
  const plain = String(message && message.getPlainBody ? (message.getPlainBody() || '') : '')
  const html = String(message && message.getBody ? (message.getBody() || '') : '')
  const htmlText = cefAtesteHtmlToReadableText_(html)
  return {
    plainLength: plain.length,
    htmlLength: html.length,
    htmlTextLength: htmlText.length,
    readableLength: String(readableBody || '').length,
    readableSample: String(readableBody || '').slice(0, 1200)
  }
}

function cefAtesteWasProcessed_(messageId) {
  return PropertiesService.getScriptProperties().getProperty(CEF_ATESTE_PROCESSED_PROP_PREFIX_ + messageId) === '1'
}

function cefAtesteWasProcessedMessage_(message) {
  const messageId = String(message && message.getId ? message.getId() : '').trim()
  if (messageId && cefAtesteWasProcessed_(messageId)) return true
  return cefAtesteMessageHasProcessedLabel_(message)
}

function cefAtesteMessageHasProcessedLabel_(message) {
  const labelNames = cefAtesteGetMessageLabels_(message)
  for (let i = 0; i < labelNames.length; i++) {
    if (String(labelNames[i] || '') === CEF_ATESTE_PROCESSED_LABEL_) return true
  }
  return false
}

function cefAtesteMarkProcessed_(messageId, data, message, processedLabel) {
  const props = PropertiesService.getScriptProperties()
  props.setProperty(CEF_ATESTE_PROCESSED_PROP_PREFIX_ + messageId, '1')
  props.setProperty(CEF_ATESTE_PROCESSED_PROP_PREFIX_ + messageId + '_DATA', JSON.stringify(data || {}))
  cefAtesteMarkMessageProcessedLabel_(message, processedLabel)
}

function cefAtesteMarkMessageProcessedLabel_(message, processedLabel) {
  if (!message || !message.getThread) return
  const thread = message.getThread()
  if (!thread) return
  ;(processedLabel || cefAtesteGetProcessedLabel_()).addToThread(thread)
}

function cefAtesteGetProcessedLabel_() {
  return GmailApp.getUserLabelByName(CEF_ATESTE_PROCESSED_LABEL_) || GmailApp.createLabel(CEF_ATESTE_PROCESSED_LABEL_)
}

function cefAtesteGetMessageLabels_(message) {
  const thread = message.getThread()
  const labels = thread ? thread.getLabels() : []
  const out = []
  for (let i = 0; i < labels.length; i++) {
    out.push(String(labels[i].getName() || ''))
  }
  return out
}

function cefAtesteMarkError_(messageId, error) {
  PropertiesService.getScriptProperties().setProperty(CEF_ATESTE_ERROR_PROP_PREFIX_ + messageId, String(error || 'error'))
}

function cefAtesteLog_(altered, dealId, title, fields, patch) {
  if (typeof appendLog_ === 'function') {
    appendLog_({
      timestamp: new Date(),
      dealId: dealId || '',
      title: title || '',
      action: 'cef_ateste_data_primeiro_ateste',
      fn: 'processarAtestesPagamentoCefDataPrimeiroAteste',
      altered: altered,
      fields: fields || '',
      patch: patch || {},
      changedKeys: []
    })
    return
  }

  console.log(JSON.stringify({
    timestamp: new Date(),
    action: 'cef_ateste_data_primeiro_ateste',
    altered: altered,
    dealId: dealId || '',
    title: title || '',
    fields: fields || '',
    patch: patch || {}
  }))
}

function cefAtesteNormalize_(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .trim()
}

function cefAtesteNormalizeCode_(value) {
  return String(value == null ? '' : value).replace(/\D+/g, '').trim()
}

function cefAtesteFormatDate_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone() || 'America/Sao_Paulo', 'yyyy-MM-dd')
}

function cefAtesteEscapeRegExp_(value) {
  return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
}

