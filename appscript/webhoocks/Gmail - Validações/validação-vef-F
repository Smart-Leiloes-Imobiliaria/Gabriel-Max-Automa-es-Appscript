function removerTriggerDevolutivasCefIptuCondominio() {
  const triggers = ScriptApp.getProjectTriggers()
  for (let i = 0; i < triggers.length; i++) {
    if (String(triggers[i].getHandlerFunction() || '') === 'processarDevolutivasCefIptuCondominio') {
      ScriptApp.deleteTrigger(triggers[i])
    }
