}

function testarFluxoCompletoIptuCondominioEmailEspecifico() {
  const props = PropertiesService.getScriptProperties()
  const messageId = String(props.getProperty('CEF_DEVOLUTIVA_TEST_MESSAGE_ID') || '').trim()
  const executar = cefDevolutivaBool_(props.getProperty('CEF_DEVOLUTIVA_TEST_EXECUTE_FLUXO_COMPLETO'))
  if (!messageId) {
    throw new Error(
      'Configure CEF_DEVOLUTIVA_TEST_MESSAGE_ID nas Script Properties. ' +
      'Por padrão o teste apenas valida; para executar, configure CEF_DEVOLUTIVA_TEST_EXECUTE_FLUXO_COMPLETO=true.'
    )
  }
  const message = cefDevolutivaGetTestMessageById_(messageId)
  const result = cefDevolutivaValidarFluxoCompletoEmail_(message, executar)
  Logger.log(JSON.stringify(result, null, 2))
  return result
}

function cefDevolutivaGetTestMessageById_(messageId) {
  try {
    const message = GmailApp.getMessageById(messageId)
    if (message) return message
  } catch (err) {
    throw new Error(
      'Mensagem Gmail não encontrada para CEF_DEVOLUTIVA_TEST_MESSAGE_ID=' + messageId +
      '. Use o ID interno da mensagem do Gmail, não o Message-ID do cabeçalho. Erro original: ' +
      String(err && err.message ? err.message : err)
    )
  }
  throw new Error('Mensagem Gmail não encontrada para CEF_DEVOLUTIVA_TEST_MESSAGE_ID=' + messageId)
}

function cefDevolutivaValidarFluxoCompletoEmail_(message, executar) {
  const messageId = String(message.getId() || '').trim()
  const subject = String(message.getSubject() || '')
  const from = String(message.getFrom() || '')
  const body = cefDevolutivaGetReadableBody_(message)
  const labelNames = cefDevolutivaGetMessageLabels_(message)
  const atesteEntry = cefDevolutivaIsAtestePagamentoEntry_(subject, labelNames)
  const eligible = cefDevolutivaIsEligibleMessage_(subject, labelNames)
  const temporalEligible = cefDevolutivaMessageIsFromProcessDate_(message)
  const result = {
    ok: false,
    execute: !!executar,
    messageId: messageId,
    subject: subject,
    messageDate: cefDevolutivaNormalizePipedriveDate_(message.getDate()),
    from: from,
    labels: labelNames,
    mode: atesteEntry ? 'primeiro_ateste_somente_data' : 'devolutiva_com_atividade',
    validations: {
      eligibleMessage: eligible,
      temporalEligible: temporalEligible,
      alreadyProcessed: cefDevolutivaWasProcessedMessage_(message)
    },
    errors: []
  }

  if (!messageId) result.errors.push('empty_message_id')
  if (!eligible) result.errors.push('missing_entry_rule')
  if (!temporalEligible) result.errors.push('message_before_process_date')

  if (atesteEntry) {
    cefDevolutivaPrevalidarFluxoPrimeiroAteste_(result, subject, from, body, labelNames, messageId)
  } else {
    cefDevolutivaPrevalidarFluxoDevolutiva_(result, subject, from, body, labelNames, messageId)
  }

  result.prevalidationOk = result.errors.length === 0
  result.ok = result.prevalidationOk

  if (executar && result.prevalidationOk) {
    result.execution = cefDevolutivaExecutarEVerificarFluxo_(message, result)
    result.ok = result.prevalidationOk && result.execution.ok === true
  } else if (executar) {
    result.execution = {
      ok: false,
      skipped: 'prevalidation_failed',
      errors: result.errors.slice(0)
    }
  }

  return result
}

function cefDevolutivaPrevalidarFluxoPrimeiroAteste_(result, subject, from, body, labelNames, messageId) {
  const expenseInfo = cefDevolutivaExtractAtesteExpenseInfo_(body)
  const despesa = expenseInfo.value
  const relation = cefDevolutivaClassifyExpenseText_(despesa)
  const propertyCode = cefDevolutivaExtractPropertyCode_(subject, body)
  const config = cefDevolutivaGetPrimeiroAtesteFieldConfig_(relation)
  let deal = null
  let currentAtesteDate = ''
  let arrivalDate = ''
  let patch = {}
  const hasCefSource = cefDevolutivaHasCefSource_(subject, from, body, messageId)

  result.expense = {
    despesa: despesa || '',
    relation: relation || '',
    source: expenseInfo.source
  }
  result.propertyCode = propertyCode || ''

  if (!hasCefSource) result.errors.push('missing_cef_source')
  if (!despesa) result.errors.push('despesa_not_found')
  else if (!relation) result.errors.push('unsupported_despesa')
  if (!propertyCode) result.errors.push('property_code_not_found')
  if (relation && !config) result.errors.push('invalid_relation_for_first_ateste')
  if (hasCefSource && relation && propertyCode && !cefDevolutivaHasPipedriveConfig_()) result.errors.push('pipedrive_config_missing')

  if (hasCefSource && relation && propertyCode && cefDevolutivaHasPipedriveConfig_()) {
    deal = cefDevolutivaFindDealByPropertyCode_(propertyCode)
    if (!deal || !deal.id) {
      result.errors.push('deal_not_found')
    } else if (config) {
      currentAtesteDate = cefDevolutivaGetDealFieldValue_(deal, config.atesteFieldKey)
      arrivalDate = cefDevolutivaNormalizePipedriveDate_(cefDevolutivaGetDealFieldValue_(deal, config.chegadaFieldKey)) ||
        cefDevolutivaNormalizePipedriveDate_(result.messageDate || '')
      if (cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate)) {
        if (arrivalDate) patch[config.atesteFieldKey] = arrivalDate
        else result.errors.push('arrival_date_not_found')
      }
    }
  }

  result.deal = {
    id: deal && deal.id ? deal.id : '',
    title: deal && deal.title ? deal.title : ''
  }
  result.activity = {
    expected: false,
    skipped: 'not_created_for_first_ateste'
  }
  result.fields = config ? {
    chegadaFieldKey: config.chegadaFieldKey,
    chegadaFieldName: config.chegadaFieldName,
    atesteFieldKey: config.atesteFieldKey,
    atesteFieldName: config.atesteFieldName,
    currentAtesteDate: currentAtesteDate,
    currentAtesteFilled: !cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate),
    arrivalDate: arrivalDate,
    wouldPatch: Object.keys(patch).length > 0,
    patch: patch
  } : {}
}

function cefDevolutivaPrevalidarFluxoDevolutiva_(result, subject, from, body, labelNames, messageId) {
  const classification = cefDevolutivaClassify_(subject, from, labelNames, body, messageId)
  const propertyCode = classification.valid ? cefDevolutivaExtractPropertyCode_(subject, body) : ''
  let deal = null
  let ownerResolution = null
  let alreadyHasActivity = false
  let patch = {}

  result.expense = {
    relation: classification.relation || '',
    source: classification.source || '',
    classification: classification
  }
  result.propertyCode = propertyCode || ''

  if (!classification.valid) result.errors.push(classification.reason || 'invalid_relation')
  if (classification.valid && !propertyCode) result.errors.push('property_code_not_found')
  if (classification.valid && propertyCode && !cefDevolutivaHasPipedriveConfig_()) result.errors.push('pipedrive_config_missing')

  if (classification.valid && propertyCode && cefDevolutivaHasPipedriveConfig_()) {
    deal = cefDevolutivaFindDealByPropertyCode_(propertyCode)
    if (!deal || !deal.id) {
      result.errors.push('deal_not_found')
    } else {
      ownerResolution = cefDevolutivaResolveActivityOwnerUserId_(deal, classification.relation)
      if (!ownerResolution.userId) {
        result.errors.push('activity_owner_not_resolved')
      } else {
        alreadyHasActivity = cefDevolutivaActivityExists_(deal.id, ownerResolution.userId, messageId, classification.relation)
      }
      patch = cefDevolutivaBuildDealPatch_(classification.relation)
    }
  }

  result.deal = {
    id: deal && deal.id ? deal.id : '',
    title: deal && deal.title ? deal.title : ''
  }
  result.activity = {
    expected: !!(deal && deal.id && ownerResolution && ownerResolution.userId && !alreadyHasActivity),
    alreadyExists: alreadyHasActivity,
    ownerResolution: ownerResolution || {},
    subject: CEF_DEVOLUTIVA_ACTIVITY_SUBJECT_,
    type: cefDevolutivaGetActivityTypeConfig_(classification.relation)
  }
  result.fields = {
    expectedStatusAndTagPatch: patch,
    wouldPatch: Object.keys(patch).length > 0
  }
}

function cefDevolutivaExecutarEVerificarFluxo_(message, prevalidation) {
  const output = { ok: false, processamento: null, verification: null, errors: [] }
  try {
    output.processamento = processarMensagemDevolutivaCef_(message)
  } catch (err) {
    output.errors.push(String(err && err.message ? err.message : err))
    return output
  }

  if (!output.processamento || output.processamento.ok !== true || output.processamento.processed !== true) {
    output.errors.push(output.processamento && output.processamento.error
      ? output.processamento.error
      : (output.processamento && output.processamento.skipped ? 'skipped:' + output.processamento.skipped : 'processing_failed'))
    return output
  }

  try {
    if (prevalidation.mode === 'primeiro_ateste_somente_data') {
      output.verification = cefDevolutivaVerifyPrimeiroAtesteFull_(
        prevalidation.deal && prevalidation.deal.id,
        prevalidation.expense && prevalidation.expense.relation,
        prevalidation.fields && prevalidation.fields.atesteFieldKey,
        prevalidation.fields && prevalidation.fields.arrivalDate,
        prevalidation.fields && prevalidation.fields.currentAtesteFilled
      )
    } else {
      output.verification = cefDevolutivaVerifyDevolutivaFull_(
        prevalidation.deal && prevalidation.deal.id,
        prevalidation.expense && prevalidation.expense.relation,
        prevalidation.activity && prevalidation.activity.ownerResolution && prevalidation.activity.ownerResolution.userId,
        prevalidation.messageId,
        output.processamento && output.processamento.activityId
      )
    }
    if (output.verification && output.verification.activity) {
      output.verification.activity.expectedCreation = !!(prevalidation.activity && prevalidation.activity.expected)
      output.verification.activity.alreadyExistsBefore = !!(prevalidation.activity && prevalidation.activity.alreadyExists)
      output.verification.activity.createdNow = !!(output.processamento && output.processamento.activityId)
      output.verification.activity.creationOk = output.verification.activity.expectedCreation
        ? output.verification.activity.createdNow
        : (output.verification.activity.alreadyExistsBefore || !output.verification.activity.createdNow)
      output.verification.ok = output.verification.ok === true && output.verification.activity.creationOk === true
    }
    output.ok = output.verification && output.verification.ok === true
  } catch (err) {
    output.errors.push(String(err && err.message ? err.message : err))
  }

  return output
}

function cefDevolutivaVerifyDevolutivaFull_(dealId, relation, ownerUserId, messageId, activityId) {
  if (!dealId || !relation) return { ok: false, error: 'missing_deal_or_relation' }
  const freshDeal = cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(dealId)), 'GET', null)
  const dealStatus = cefDevolutivaVerifyDealStatus_(freshDeal, relation)
  const dealPatch = cefDevolutivaVerifyDealPatch_(freshDeal, relation)
  const activity = cefDevolutivaVerifyActivity_(dealId, ownerUserId, messageId, activityId, relation)
  return {
    ok: dealStatus.ok === true && activity.ok === true,
    dealId: dealId,
    relation: relation,
    dealStatus: dealStatus,
    dealPatch: dealPatch,
    activity: activity
  }
}

function cefDevolutivaVerifyPrimeiroAtesteFull_(dealId, relation, fieldKey, expectedDate, alreadyFilledBefore) {
  if (!dealId || !relation || !fieldKey) return { ok: false, error: 'missing_deal_relation_or_field' }
  const freshDeal = cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(dealId)), 'GET', null)
  const primeiroAtesteDate = cefDevolutivaVerifyPrimeiroAtestePatchFromDeal_(freshDeal, fieldKey, expectedDate, alreadyFilledBefore)
  const activity = { ok: true, skipped: 'not_created_for_first_ateste' }
  return {
    ok: primeiroAtesteDate.ok === true,
    dealId: dealId,
    relation: relation,
    dealStatus: { ok: true, skipped: 'not_expected_for_ateste' },
    dealPatch: { ok: true, skipped: 'not_expected_for_ateste' },
    primeiroAtesteDate: primeiroAtesteDate,
    activity: activity
  }
}

function cefDevolutivaVerifyPrimeiroAtestePatch_(dealId, fieldKey, expectedDate, alreadyFilledBefore) {
  if (!dealId || !fieldKey) return { ok: false, error: 'missing_deal_or_field' }
  const freshDeal = cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(dealId)), 'GET', null)
  return cefDevolutivaVerifyPrimeiroAtestePatchFromDeal_(freshDeal, fieldKey, expectedDate, alreadyFilledBefore)
}

function cefDevolutivaVerifyPrimeiroAtestePatchFromDeal_(deal, fieldKey, expectedDate, alreadyFilledBefore) {
  const actual = cefDevolutivaGetDealFieldValue_(deal, fieldKey)
  const normalizedActual = cefDevolutivaNormalizePipedriveDate_(actual)

  if (alreadyFilledBefore) {
    return {
      ok: !cefDevolutivaIsEmptyPipedriveValue_(actual),
      alreadyFilledBefore: true,
      actual: actual,
      normalizedActual: normalizedActual
    }
  }

  return {
    ok: normalizedActual === expectedDate,
    expectedDate: expectedDate,
    actual: actual,
    normalizedActual: normalizedActual
  }
}

function cefDevolutivaVerifyActivityExists_(dealId, ownerUserId, messageId, relation) {
  if (!dealId || !ownerUserId || !messageId) {
    return {
      ok: false,
      error: 'missing_deal_owner_or_message',
      dealId: dealId || '',
      ownerUserId: ownerUserId || '',
      messageId: messageId || ''
    }
  }

  return {
    ok: cefDevolutivaActivityExists_(dealId, ownerUserId, messageId, relation) === true,
    dealId: dealId,
    ownerUserId: ownerUserId,
    messageId: messageId,
    subject: CEF_DEVOLUTIVA_ACTIVITY_SUBJECT_
  }
}

function cefDevolutivaVerifyActivity_(dealId, ownerUserId, messageId, activityId, relation) {
  if (activityId) {
    try {
      const response = cefDevolutivaCallPipedrive_('activities/' + encodeURIComponent(String(activityId)), 'GET', null) || {}
      const activity = response && Object.prototype.hasOwnProperty.call(response, 'data') ? response.data : response
      const subject = String(activity && activity.subject || '').trim()
      const note = String(activity && activity.note || '')
      const uid = cefDevolutivaExtractActivityUserId_(activity)
      const activityDealId = cefDevolutivaExtractActivityDealId_(activity)
      const typeConfig = cefDevolutivaGetActivityTypeConfig_(relation)
      return {
        ok:
          subject === CEF_DEVOLUTIVA_ACTIVITY_SUBJECT_ &&
          note.indexOf(String(messageId || '')) >= 0 &&
          (!typeConfig || cefDevolutivaActivityMatchesType_(activity, typeConfig.key)) &&
          (!ownerUserId || Number(uid) === Number(ownerUserId)) &&
          (!activityDealId || Number(activityDealId) === Number(dealId)),
        source: 'activity_id',
        id: activityId,
        dealId: dealId,
        ownerUserId: ownerUserId || '',
        actualOwnerUserId: uid || '',
        actualDealId: activityDealId || '',
        messageId: messageId,
        subject: subject
      }
    } catch (err) {
      return {
        ok: false,
        source: 'activity_id',
        id: activityId,
        error: String(err && err.message ? err.message : err)
      }
    }
  }

  const exists = cefDevolutivaVerifyActivityExists_(dealId, ownerUserId, messageId, relation)
  exists.source = 'activity_search'
  return exists
}

function cefDevolutivaBool_(value) {
  if (value === true) return true
  if (value === 1) return true
  const text = String(value || '').trim().toLowerCase()
  return text === '1' || text === 'true' || text === 'sim' || text === 'yes'
}

function cefDevolutivaExtractActivityId_(activity) {
  if (!activity) return ''
  if (activity.id) return activity.id
  if (activity.data && activity.data.id) return activity.data.id
  if (activity.activity && activity.activity.id) return activity.activity.id
  return ''
}

function cefDevolutivaVerifyDealPatch_(deal, relation) {
  const expected = cefDevolutivaBuildDealPatch_(relation)
  const checks = []
  let ok = true
  const keys = Object.keys(expected)

  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const actual = cefDevolutivaGetDealFieldValue_(deal, key)
    const checkOk = String(actual) === String(expected[key])
    if (!checkOk) ok = false
    checks.push({
      key: key,
      expected: expected[key],
      actual: actual,
      ok: checkOk
    })
  }

  return { ok: ok, checks: checks }
}

function cefDevolutivaVerifyDealStatus_(deal, relation) {
  let fieldKey = ''
  let expected = ''

  if (relation === CEF_DEVOLUTIVA_REL_IPTU_) {
    fieldKey = CEF_DEVOLUTIVA_STATUS_IPTU_FIELD_KEY_
    expected = CEF_DEVOLUTIVA_STATUS_IPTU_PENDENCIA_ID_
  } else if (relation === CEF_DEVOLUTIVA_REL_CONDOMINIO_) {
    fieldKey = CEF_DEVOLUTIVA_STATUS_CONDOMINIO_FIELD_KEY_
    expected = CEF_DEVOLUTIVA_STATUS_CONDOMINIO_PENDENCIA_ID_
  } else {
    return { ok: false, error: 'invalid_relation', relation: relation }
  }

  const actual = cefDevolutivaGetDealFieldValue_(deal, fieldKey)
  return {
    ok: String(actual) === String(expected),
    key: fieldKey,
    expected: expected,
    actual: actual
  }
}

function cefDevolutivaScanLabelThreads_(handleMessage, seenMessages, maxMessages) {
  const labels = cefDevolutivaGetCandidateGmailLabels_()
  let handled = 0

  for (let l = 0; l < labels.length && handled < maxMessages; l++) {
    for (let start = 0; start < CEF_DEVOLUTIVA_MAX_THREADS_PER_RUN_ && handled < maxMessages; start += CEF_DEVOLUTIVA_THREAD_PAGE_SIZE_) {
      const threads = labels[l].getThreads(start, CEF_DEVOLUTIVA_THREAD_PAGE_SIZE_)
      if (!threads.length) break

      for (let i = 0; i < threads.length && handled < maxMessages; i++) {
        const messages = threads[i].getMessages()
        for (let j = 0; j < messages.length && handled < maxMessages; j++) {
          const messageId = String(messages[j].getId() || '').trim()
          if (messageId && seenMessages[messageId]) continue
          if (messageId) seenMessages[messageId] = true
          if (handleMessage(messages[j], 'label:' + labels[l].getName()) === false) return
          handled++
        }
      }
    }
  }
}

function cefDevolutivaGetCandidateGmailLabels_() {
  const labels = GmailApp.getUserLabels()
  const out = []
  const seen = {}

  for (let i = 0; i < labels.length; i++) {
    const name = String(labels[i].getName() || '')
    if (cefDevolutivaIsEntryLabel_(name)) {
      if (!seen[name]) {
        out.push(labels[i])
        seen[name] = true
      }
    }
  }

  return out.sort(function (a, b) {
    return cefDevolutivaLabelPriority_(a.getName()) - cefDevolutivaLabelPriority_(b.getName())
  })
}

function cefDevolutivaHasEntryLabel_(labelNames) {
  for (let i = 0; i < (labelNames || []).length; i++) {
    if (cefDevolutivaIsEntryLabel_(labelNames[i])) return true
  }
  return false
}

function cefDevolutivaHasEntrySubject_(subject) {
  const normalized = cefDevolutivaNormalize_(subject)
  const hasAnaliseDocumental =
    normalized.indexOf('analise documental') >= 0 &&
    normalized.indexOf('imovel') >= 0 &&
    /\bid\b/.test(normalized)
  return hasAnaliseDocumental || cefDevolutivaHasAtestePagamentoSubject_(subject)
}

function cefDevolutivaIsEligibleMessage_(subject, labelNames) {
  return cefDevolutivaHasEntryLabel_(labelNames) || cefDevolutivaHasEntrySubject_(subject)
}

function cefDevolutivaIsAtestePagamentoEntry_(subject, labelNames) {
  return cefDevolutivaHasAtestePagamentoSubject_(subject)
}

function cefDevolutivaHasAtestePagamentoSubject_(subject) {
  const normalized = cefDevolutivaNormalize_(subject)
  // O assunto da CEF pode variar (com/sem "ID", "BEM" ou "Imóvel").
  // Toda mensagem explicitamente identificada como ateste deve seguir o fluxo
  // que apenas grava a data, nunca o fluxo de devolutiva que cria atividade.
  return normalized.indexOf('ateste de pagamento') >= 0
}

function cefDevolutivaIsEntryLabel_(name) {
  const normalized = cefDevolutivaNormalize_(name)
  for (let i = 0; i < CEF_DEVOLUTIVA_ENTRY_LABELS_.length; i++) {
    const expected = cefDevolutivaNormalize_(CEF_DEVOLUTIVA_ENTRY_LABELS_[i])
    if (expected.indexOf('ateste de pagamento id') >= 0) continue
    if (normalized === expected) return true
  }
  return false
}

function cefDevolutivaLabelPriority_(name) {
  const normalized = cefDevolutivaNormalize_(name)
  if (normalized.indexOf('analise documental') >= 0) return 0
  if (normalized.indexOf('ateste de pagamento') >= 0) return 1
  if (normalized === cefDevolutivaNormalize_(CEF_DEVOLUTIVA_REL_IPTU_)) return 90
  if (normalized === cefDevolutivaNormalize_(CEF_DEVOLUTIVA_REL_CONDOMINIO_)) return 90
  return 10
}

function processarMensagemDevolutivaCef_(message) {
  const messageId = String(message.getId() || '').trim()
  if (!messageId) return { ok: false, error: 'empty_message_id' }
  if (!cefDevolutivaMessageIsFromProcessDate_(message)) return { ok: true, skipped: 'message_before_process_date' }
  if (cefDevolutivaWasProcessedMessage_(message)) {
    return { ok: true, skipped: 'already_processed' }
  }

  const subject = String(message.getSubject() || '')
  const from = String(message.getFrom() || '')
  const plainBody = cefDevolutivaGetReadableBody_(message)
  const labelNames = cefDevolutivaGetMessageLabels_(message)
  if (!cefDevolutivaIsEligibleMessage_(subject, labelNames)) {
    return { ok: true, skipped: 'missing_entry_rule' }
  }

  if (cefDevolutivaIsAtestePagamentoEntry_(subject, labelNames)) {
    return cefDevolutivaProcessarPrimeiroAteste_(message, messageId, subject, from, plainBody, labelNames)
  }

  const classification = cefDevolutivaClassify_(subject, from, labelNames, plainBody, messageId)

  if (!classification.valid) {
    return { ok: true, skipped: classification.reason || 'invalid_relation' }
  }

  const propertyCode = cefDevolutivaExtractPropertyCode_(subject, plainBody)
  if (!propertyCode) {
    cefDevolutivaLog_('ERROR', '', subject, 'property_code_not_found', {
      messageId: messageId,
      from: from,
      labels: labelNames,
      relation: classification.relation
    })
    cefDevolutivaMarkError_(messageId, 'property_code_not_found')
    return { ok: false, error: 'property_code_not_found' }
  }

  if (!cefDevolutivaHasPipedriveConfig_()) {
    cefDevolutivaLog_('ERROR', '', subject, 'pipedrive_config_missing', {
      messageId: messageId,
      from: from,
      propertyCode: propertyCode,
      relation: classification.relation
    })
    cefDevolutivaMarkError_(messageId, 'pipedrive_config_missing')
    return { ok: false, error: 'pipedrive_config_missing', propertyCode: propertyCode }
  }

  const deal = cefDevolutivaFindDealByPropertyCode_(propertyCode)
  if (!deal || !deal.id) {
    cefDevolutivaLog_('ERROR', '', subject, 'deal_not_found', {
      messageId: messageId,
      from: from,
      propertyCode: propertyCode,
      relation: classification.relation
    })
    cefDevolutivaMarkError_(messageId, 'deal_not_found:' + propertyCode)
    return { ok: false, error: 'deal_not_found', propertyCode: propertyCode }
  }

  const ownerResolution = cefDevolutivaResolveActivityOwnerUserId_(deal, classification.relation)
  const ownerUserId = ownerResolution.userId
  if (!ownerUserId) {
    cefDevolutivaLog_('ERROR', deal.id, subject, 'activity_owner_not_resolved', {
      messageId: messageId,
      from: from,
      propertyCode: propertyCode,
      relation: classification.relation,
      ownerResolution: ownerResolution
    })
    cefDevolutivaMarkError_(messageId, 'activity_owner_not_resolved:' + propertyCode)
    return { ok: false, error: 'activity_owner_not_resolved', dealId: deal.id, propertyCode: propertyCode }
  }

  const alreadyHasActivity = cefDevolutivaActivityExists_(deal.id, ownerUserId, messageId, classification.relation)
  let activity = null
  if (!alreadyHasActivity) {
    activity = cefDevolutivaCreateActivity_(deal.id, ownerUserId, messageId, propertyCode, classification)
  }

  const patch = cefDevolutivaBuildDealPatch_(classification.relation)
  cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(deal.id)), 'PUT', patch)

  cefDevolutivaMarkProcessed_(messageId, {
    dealId: deal.id,
    propertyCode: propertyCode,
    relation: classification.relation,
    activityId: activity && activity.id ? activity.id : '',
    skippedActivity: alreadyHasActivity
  }, message)

  cefDevolutivaLog_('SIM', deal.id, subject, 'processed', {
    messageId: messageId,
    from: from,
    propertyCode: propertyCode,
    relation: classification.relation,
    ownerUserId: ownerUserId,
    activityId: activity && activity.id ? activity.id : '',
    skippedActivity: alreadyHasActivity,
    patch: patch
  })

  return {
    ok: true,
    processed: true,
    dealId: deal.id,
    propertyCode: propertyCode,
    activityId: activity && activity.id ? activity.id : '',
    ownerUserId: ownerUserId,
    ownerResolution: ownerResolution,
    skippedActivity: alreadyHasActivity
  }
}

function cefDevolutivaProcessarPrimeiroAteste_(message, messageId, subject, from, body, labelNames) {
  if (!cefDevolutivaMessageIsAfterProcessDate_(message)) {
    return { ok: true, skipped: 'ateste_message_not_after_today' }
  }

  if (!cefDevolutivaHasCefSource_(subject, from, body, messageId)) {
    return { ok: true, skipped: 'missing_cef_source' }
  }

  const expenseInfo = cefDevolutivaExtractAtesteExpenseInfo_(body)
  const despesa = expenseInfo.value
  const relation = cefDevolutivaClassifyExpenseText_(despesa)
  if (!despesa || !relation) {
    const reason = !despesa ? 'despesa_not_found' : 'unsupported_despesa'
    cefDevolutivaLog_('ERROR', '', subject, reason, {
      messageId: messageId,
      from: from,
      labels: labelNames,
      despesa: despesa || '',
      expenseSource: expenseInfo.source
    })
    cefDevolutivaMarkError_(messageId, reason)
    return { ok: false, error: reason, despesa: despesa || '', expenseSource: expenseInfo.source }
  }

  const propertyCode = cefDevolutivaExtractPropertyCode_(subject, body)
  if (!propertyCode) {
    cefDevolutivaLog_('ERROR', '', subject, 'property_code_not_found', {
      messageId: messageId,
      from: from,
      labels: labelNames,
      relation: relation,
      despesa: despesa
    })
    cefDevolutivaMarkError_(messageId, 'property_code_not_found')
    return { ok: false, error: 'property_code_not_found', relation: relation }
  }

  if (!cefDevolutivaHasPipedriveConfig_()) {
    cefDevolutivaLog_('ERROR', '', subject, 'pipedrive_config_missing', {
      messageId: messageId,
      from: from,
      propertyCode: propertyCode,
      relation: relation
    })
    cefDevolutivaMarkError_(messageId, 'pipedrive_config_missing')
    return { ok: false, error: 'pipedrive_config_missing', propertyCode: propertyCode, relation: relation }
  }

  const deal = cefDevolutivaFindDealByPropertyCode_(propertyCode)
  if (!deal || !deal.id) {
    cefDevolutivaLog_('ERROR', '', subject, 'deal_not_found', {
      messageId: messageId,
      from: from,
      propertyCode: propertyCode,
      relation: relation,
      despesa: despesa
    })
    cefDevolutivaMarkError_(messageId, 'deal_not_found:' + propertyCode)
    return { ok: false, error: 'deal_not_found', propertyCode: propertyCode, relation: relation }
  }

  const config = cefDevolutivaGetPrimeiroAtesteFieldConfig_(relation)
  if (!config) {
    cefDevolutivaLog_('NAO', deal.id, subject, 'invalid_relation_for_first_ateste', {
      messageId: messageId,
      propertyCode: propertyCode,
      relation: relation,
      despesa: despesa
    })
    cefDevolutivaMarkProcessed_(messageId, { skipped: 'invalid_relation_for_first_ateste', dealId: deal.id }, message)
    return { ok: true, skipped: 'invalid_relation_for_first_ateste', dealId: deal.id, propertyCode: propertyCode }
  }

  const patch = {}
  let arrivalDate = ''

  const currentAtesteDate = cefDevolutivaGetDealFieldValue_(deal, config.atesteFieldKey)
  if (!cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate)) {
    cefDevolutivaLog_('NAO', deal.id, subject, 'first_ateste_already_filled', {
      messageId: messageId,
      propertyCode: propertyCode,
      relation: relation,
      fieldKey: config.atesteFieldKey,
      fieldName: config.atesteFieldName,
      currentValue: currentAtesteDate
    })
    cefDevolutivaMarkProcessed_(messageId, {
      dealId: deal.id,
      propertyCode: propertyCode,
      relation: relation,
      despesa: despesa,
      fieldKey: config.atesteFieldKey,
      firstAtesteAlreadyFilled: true
    }, message)
    return {
      ok: true,
      processed: true,
      skipped: 'first_ateste_already_filled',
      dealId: deal.id,
      propertyCode: propertyCode,
      relation: relation,
      firstAtesteAlreadyFilled: true
    }
  } else {
    arrivalDate = cefDevolutivaNormalizePipedriveDate_(cefDevolutivaGetDealFieldValue_(deal, config.chegadaFieldKey)) ||
      cefDevolutivaNormalizePipedriveDate_(message.getDate())
    if (arrivalDate) {
      patch[config.atesteFieldKey] = arrivalDate
    } else {
      cefDevolutivaLog_('NAO', deal.id, subject, 'arrival_date_not_found', {
        messageId: messageId,
        propertyCode: propertyCode,
        relation: relation,
        chegadaFieldKey: config.chegadaFieldKey,
        chegadaFieldName: config.chegadaFieldName
      })
      cefDevolutivaMarkError_(messageId, 'arrival_date_not_found:' + propertyCode)
      return { ok: false, error: 'arrival_date_not_found', dealId: deal.id, propertyCode: propertyCode, relation: relation }
    }
  }

  if (Object.keys(patch).length) {
    cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(deal.id)), 'PUT', patch)
  }

  cefDevolutivaMarkProcessed_(messageId, {
    dealId: deal.id,
    propertyCode: propertyCode,
    relation: relation,
    despesa: despesa,
    arrivalDate: arrivalDate,
    fieldKey: config.atesteFieldKey,
    firstAtesteAlreadyFilled: !cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate)
  }, message)

  cefDevolutivaLog_('SIM', deal.id, subject, 'first_ateste_date_filled', {
    messageId: messageId,
    from: from,
    propertyCode: propertyCode,
    relation: relation,
    despesa: despesa,
    arrivalDate: arrivalDate,
    firstAtesteAlreadyFilled: !cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate),
    patch: patch
  })

  return {
    ok: true,
    processed: true,
    dealId: deal.id,
    propertyCode: propertyCode,
    relation: relation,
    firstAtesteAlreadyFilled: !cefDevolutivaIsEmptyPipedriveValue_(currentAtesteDate)
  }
}

function cefDevolutivaClassify_(subject, from, labelNames, body, messageId) {
  const tipoDespesa = cefDevolutivaExtractTipoDespesa_(body)
  const despesa = cefDevolutivaExtractDespesa_(body)

  if (!cefDevolutivaHasCefSource_(subject, from, body, messageId)) {
    return { valid: false, reason: 'missing_cef_source' }
  }

  if (tipoDespesa) {
    const tipoDespesaRelation = cefDevolutivaClassifyExpenseText_(tipoDespesa)
    if (tipoDespesaRelation) return { valid: true, relation: tipoDespesaRelation, source: 'tipo_despesa' }
    return { valid: false, reason: 'unsupported_tipo_despesa', tipoDespesa: tipoDespesa }
  }

  if (despesa) {
    const despesaRelation = cefDevolutivaClassifyExpenseText_(despesa)
    if (despesaRelation) return { valid: true, relation: despesaRelation, source: 'despesa' }
    return { valid: false, reason: 'unsupported_despesa', despesa: despesa }
  }

  return { valid: false, reason: 'expense_relation_not_found' }
}

function cefDevolutivaHasCefSource_(subject, from, body, messageId) {
  return cefDevolutivaTextHasCefSource_([subject, from, body].join('\n'))
}

function cefDevolutivaTextHasCefSource_(value) {
  const text = cefDevolutivaNormalize_(value)
  return /\bcef\b/.test(text) || text.indexOf('caixa') >= 0
}

function cefDevolutivaExtractPropertyCode_(subject, body) {
  const fromSubject = cefDevolutivaPickPropertyCode_([subject])
  if (fromSubject) return fromSubject
  return cefDevolutivaPickPropertyCode_([body])
}

function cefDevolutivaPickPropertyCode_(parts) {
  const text = String((parts || []).join('\n') || '')
  const patterns = [
    /(?:im[oó]vel|bem)\s*[:\-]\s*([0-9][0-9.\-\/]{2,})/ig,
    /(?:c[oó]digo\s+do\s+im[oó]vel|c[oó]digo|cod\.?)\s*[:\-]\s*([0-9][0-9.\-\/]{2,})/ig
  ]

  for (let p = 0; p < patterns.length; p++) {
    let match
    while ((match = patterns[p].exec(text)) !== null) {
      const code = cefDevolutivaNormalizeCode_(match[1])
      if (code) return code
    }
  }

  return ''
}

function cefDevolutivaFindDealByPropertyCode_(propertyCode) {
  if (!cefDevolutivaHasPipedriveConfig_()) {
    throw new Error('Configure BASE_URL/PIPEDRIVE_BASE_URL and PIPEDRIVE_TOKEN/PIPEDRIVE_API_TOKEN in Script Properties.')
  }

  const code = String(propertyCode || '').trim()
  if (!code) return null

  const attempts = [
    'deals/search?term=' + encodeURIComponent(code) + '&exact_match=1&fields=title,custom_fields&limit=20',
    'deals/search?term=' + encodeURIComponent(code) + '&fields=title,custom_fields&limit=50'
  ]
  const codeDigits = cefDevolutivaNormalizeCode_(code)

  for (let a = 0; a < attempts.length; a++) {
    const response = cefDevolutivaCallPipedrive_(attempts[a], 'GET', null) || {}
    const items = response && Array.isArray(response.items) ? response.items : []
    for (let i = 0; i < items.length; i++) {
      const item = items[i] && items[i].item ? items[i].item : (items[i] || {})
      const deal = item.id ? cefDevolutivaCallPipedrive_('deals/' + encodeURIComponent(String(item.id)), 'GET', null) : null
      if (!deal || !deal.id) continue

      const dealCode = cefDevolutivaNormalizeCode_(cefDevolutivaGetDealFieldValue_(deal, CEF_DEVOLUTIVA_NUMERO_IMOVEL_FIELD_KEY_))
      const titleCode = cefDevolutivaNormalizeCode_(deal.title || item.title || '')
      if (dealCode === codeDigits || (titleCode && titleCode.indexOf(codeDigits) >= 0)) return deal
    }
  }

  return null
}

function cefDevolutivaResolveActivityOwnerUserId_(deal, relation) {
  const config = cefDevolutivaGetActivityOwnerFieldConfig_(relation)
  if (!config) {
    return { userId: 0, error: 'invalid_relation', relation: relation || '' }
  }

  const raw = cefDevolutivaGetDealFieldValue_(deal, config.fieldKey)
  const selected = cefDevolutivaExtractSelectedAssigneeOption_(raw, config.options)
  const result = {
    userId: 0,
    relation: relation,
    fieldKey: config.fieldKey,
    fieldName: config.fieldName,
    optionId: selected.id || '',
    optionLabel: selected.label || '',
    rawValue: raw
  }

  if (!selected.label) {
    result.error = selected.error || 'empty_assignee_field'
    return result
  }

  if (cefDevolutivaNormalize_(selected.label) === 'n/a') {
    result.error = 'assignee_na'
    return result
  }

  const matchedUser = cefDevolutivaFindPipedriveUserByName_(selected.label)
  if (!matchedUser || !matchedUser.id) {
    result.error = 'pipedrive_user_not_resolved'
    return result
  }

  result.userId = Number(matchedUser.id) || 0
  result.userName = matchedUser.name || ''
  result.userEmail = matchedUser.email || ''
  return result
}

function cefDevolutivaGetActivityOwnerFieldConfig_(relation) {
  if (relation === CEF_DEVOLUTIVA_REL_IPTU_) {
    return {
      fieldKey: CEF_DEVOLUTIVA_ATRIBUIDO_IPTU_FIELD_KEY_,
      fieldName: 'Atribuído: IPTU',
      options: CEF_DEVOLUTIVA_ATRIBUIDO_IPTU_OPTIONS_
    }
  }

  if (relation === CEF_DEVOLUTIVA_REL_CONDOMINIO_) {
    return {
      fieldKey: CEF_DEVOLUTIVA_ATRIBUIDO_CONDOMINIO_FIELD_KEY_,
      fieldName: 'Atribuído: Condomínio',
      options: CEF_DEVOLUTIVA_ATRIBUIDO_CONDOMINIO_OPTIONS_
    }
  }

  return null
}

function cefDevolutivaExtractSelectedAssigneeOption_(raw, options) {
  if (Array.isArray(raw)) {
    return raw.length ? cefDevolutivaExtractSelectedAssigneeOption_(raw[0], options) : { id: '', label: '', error: 'empty_assignee_field' }
  }

  let value = raw
  if (value && typeof value === 'object') {
    if (Object.prototype.hasOwnProperty.call(value, 'id')) value = value.id
    else if (Object.prototype.hasOwnProperty.call(value, 'value')) value = value.value
    else if (Object.prototype.hasOwnProperty.call(value, 'label')) value = value.label
  }

  if (value == null || value === '') {
    return { id: '', label: '', error: 'empty_assignee_field' }
  }

  const id = Number(value)
  if (isFinite(id) && Object.prototype.hasOwnProperty.call(options, id)) {
    return { id: id, label: String(options[id] || '').trim() }
  }

  const label = String(value || '').trim()
  if (!label) return { id: '', label: '', error: 'empty_assignee_field' }

  for (const optionId in options) {
    if (cefDevolutivaNormalize_(options[optionId]) === cefDevolutivaNormalize_(label)) {
      return { id: Number(optionId) || optionId, label: String(options[optionId] || '').trim() }
    }
  }

  return { id: '', label: label }
}

function cefDevolutivaFindPipedriveUserByName_(name) {
  return cefDevolutivaFindPipedriveUserInListByName_(name, cefDevolutivaListPipedriveUsers_())
}

function cefDevolutivaFindPipedriveUserInListByName_(name, users) {
  const normalizedName = cefDevolutivaNormalize_(name)
  if (!normalizedName || normalizedName === 'n/a') return null

  const exact = []
  const segment = []
  const contains = []

  for (let i = 0; i < (users || []).length; i++) {
    const user = users[i] || {}
    if (user.active_flag === false || user.is_deleted === true) continue

    const userName = String(user.name || '').trim()
    const normalizedUserName = cefDevolutivaNormalize_(userName)
    if (!normalizedUserName) continue

    if (normalizedUserName === normalizedName) {
      exact.push(user)
      continue
    }

    // Renomeações como "Jessica Gomes | Gabriel Max | Davi" mantêm o
    // nome original como um segmento. Esse match é mais seguro que "contains".
    const nameSegments = String(userName || '').split('|').map(function (part) {
      return cefDevolutivaNormalize_(part)
    }).filter(function (part) {
      return !!part
    })
    if (nameSegments.indexOf(normalizedName) >= 0) {
      segment.push(user)
      continue
    }

    if (normalizedUserName.indexOf(normalizedName) >= 0 || normalizedName.indexOf(normalizedUserName) >= 0) {
      contains.push(user)
    }
  }

  if (exact.length === 1) return exact[0]
  if (exact.length > 1) return null
  if (segment.length === 1) return segment[0]
  if (segment.length > 1) return null
  return contains.length === 1 ? contains[0] : null
}

function cefDevolutivaListPipedriveUsers_() {
  if (CEF_DEVOLUTIVA_PIPEDRIVE_USERS_CACHE_) return CEF_DEVOLUTIVA_PIPEDRIVE_USERS_CACHE_

  const response = cefDevolutivaCallPipedrive_('users?limit=500', 'GET', null) || []
  CEF_DEVOLUTIVA_PIPEDRIVE_USERS_CACHE_ = Array.isArray(response) ? response : (response.data || [])
  return CEF_DEVOLUTIVA_PIPEDRIVE_USERS_CACHE_
}

function cefDevolutivaHasPipedriveConfig_() {
  try {
    const cfg = cefDevolutivaGetPipedriveConfig_()
    return !!(cfg.baseUrl && cfg.token)
  } catch (_) {
    return false
  }
}

function cefDevolutivaGetPipedriveConfig_() {
  const props = PropertiesService.getScriptProperties()
  const token = String(
    props.getProperty('PIPEDRIVE_TOKEN') ||
    props.getProperty('PIPEDRIVE_API_TOKEN') ||
    props.getProperty('PD_API_KEY') ||
    ''
  ).trim()
  const domain = String(props.getProperty('PIPEDRIVE_DOMAIN') || '').trim()
  let baseUrl = String(
    props.getProperty('BASE_URL') ||
    props.getProperty('PIPEDRIVE_BASE_URL') ||
    props.getProperty('PD_BASE_URL') ||
    (domain ? domain : '') ||
    'https://api.pipedrive.com/v1'
  ).trim()

  if (!token) throw new Error('Falta PIPEDRIVE_TOKEN ou PIPEDRIVE_API_TOKEN nas Script Properties.')
  if (!baseUrl) throw new Error('Falta BASE_URL ou PIPEDRIVE_BASE_URL nas Script Properties.')

  return { baseUrl: cefDevolutivaNormalizePipedriveBaseUrl_(baseUrl), token: token }
}

function cefDevolutivaNormalizePipedriveBaseUrl_(baseUrl) {
  let url = String(baseUrl || '').trim().replace(/\/+$/, '')
  if (!url) return ''

  if (!/^https?:\/\//i.test(url)) {
    if (url.indexOf('/') >= 0 || /\.pipedrive\.com/i.test(url)) url = 'https://' + url
    else url = 'https://' + url + '.pipedrive.com'
  }

  url = url.replace(/\/api\/v1\/api\/v1$/i, '/api/v1')
  if (/^https?:\/\/api\.pipedrive\.com$/i.test(url)) url += '/v1'
  else if (/^https?:\/\/api\.pipedrive\.com\/v1$/i.test(url)) return url
  else if (/\.pipedrive\.com$/i.test(url)) url += '/api/v1'
  else if (/\.pipedrive\.com\/v1$/i.test(url)) url = url.replace(/\/v1$/i, '/api/v1')
  else if (/\.pipedrive\.com\/api$/i.test(url)) url += '/v1'
  else if (!/\/(?:api\/)?v1$/i.test(url)) url += '/v1'

  return url
}

function cefDevolutivaCallPipedrive_(endpoint, method, payload) {
  const cfg = cefDevolutivaGetPipedriveConfig_()
  const path = String(endpoint || '').trim().replace(/^\/+/, '')
  if (!path) throw new Error('Endpoint Pipedrive vazio.')

  const hasToken = /(^|[?&])api_token=/.test(path)
  const sep = path.indexOf('?') >= 0 ? '&' : '?'
  const url = cfg.baseUrl + '/' + path + (hasToken ? '' : sep + 'api_token=' + encodeURIComponent(cfg.token))
  const requestMethod = String(method || 'GET').toUpperCase()
  const options = { method: requestMethod, muteHttpExceptions: true }

  if (payload != null && requestMethod !== 'GET' && requestMethod !== 'DELETE') {
    options.contentType = 'application/json'
    options.payload = JSON.stringify(payload)
  }

  const response = UrlFetchApp.fetch(url, options)
  const status = response.getResponseCode()
  const text = response.getContentText()
  const data = text ? JSON.parse(text) : {}

  if (status < 200 || status >= 300 || data.success === false) {
    throw new Error('Erro Pipedrive ' + status + ': ' + text + ' | URL=' + cefDevolutivaRedactPipedriveUrl_(url))
  }

  return data && Object.prototype.hasOwnProperty.call(data, 'data') ? data.data : data
}

function cefDevolutivaRedactPipedriveUrl_(url) {
  return String(url || '').replace(/([?&]api_token=)[^&\s]+/gi, '$1[REDACTED]')
}

function cefDevolutivaCreateActivity_(dealId, ownerUserId, messageId, propertyCode, classification) {
  const dueDate = cefDevolutivaFormatDate_(cefDevolutivaAddBusinessDays_(new Date(), CEF_DEVOLUTIVA_DUE_BUSINESS_DAYS_))
  const typeConfig = cefDevolutivaGetActivityTypeConfig_(classification.relation)
  if (!typeConfig) throw new Error('Relação inválida para tipo da atividade: ' + classification.relation)

  const payload = {
    subject: CEF_DEVOLUTIVA_ACTIVITY_SUBJECT_,
    type: typeConfig.key,
    deal_id: Number(dealId),
    user_id: Number(ownerUserId),
    due_date: dueDate,
    note: CEF_DEVOLUTIVA_ACTIVITY_NOTE_ + '\n\nMensagem Gmail: ' + messageId + '\nImóvel/BEM: ' + propertyCode + '\nRelação: ' + classification.relation
  }
  payload[CEF_DEVOLUTIVA_PRIORITY_FIELD_KEY_] = CEF_DEVOLUTIVA_PRIORITY_MEDIUM_ID_
  const activity = cefDevolutivaCallPipedrive_('activities', 'POST', payload)
  return cefDevolutivaEnsureActivityOwner_(activity, ownerUserId)
}

function cefDevolutivaEnsureActivityOwner_(activity, expectedOwnerUserId) {
  const activityId = activity && activity.id ? Number(activity.id) : 0
  const expectedOwner = Number(expectedOwnerUserId) || 0
  if (!activityId || !expectedOwner) {
    throw new Error('Não foi possível validar o responsável da atividade criada.')
  }

  let freshActivity = cefDevolutivaCallPipedrive_('activities/' + encodeURIComponent(String(activityId)), 'GET', null) || activity
  let actualOwner = cefDevolutivaExtractActivityUserId_(freshActivity)

  if (Number(actualOwner) !== expectedOwner) {
    cefDevolutivaCallPipedrive_(
      'activities/' + encodeURIComponent(String(activityId)),
      'PUT',
      { user_id: expectedOwner }
    )
    freshActivity = cefDevolutivaCallPipedrive_('activities/' + encodeURIComponent(String(activityId)), 'GET', null) || freshActivity
    actualOwner = cefDevolutivaExtractActivityUserId_(freshActivity)
  }

  if (Number(actualOwner) !== expectedOwner) {
    throw new Error(
      'Responsável incorreto na atividade ' + activityId +
      ': esperado=' + expectedOwner + ', recebido=' + (actualOwner || 0)
    )
  }

  return freshActivity
}

function cefDevolutivaGetActivityTypeConfig_(relation) {
  if (relation === CEF_DEVOLUTIVA_REL_IPTU_) {
    return { id: CEF_DEVOLUTIVA_TAG_IPTU_ID_, key: CEF_DEVOLUTIVA_TAG_IPTU_KEY_, name: 'IPTU', orderNr: 10 }
  }

  if (relation === CEF_DEVOLUTIVA_REL_CONDOMINIO_) {
    return { id: CEF_DEVOLUTIVA_TAG_CONDOMINIO_ID_, key: CEF_DEVOLUTIVA_TAG_CONDOMINIO_KEY_, name: 'Condomínio', orderNr: 11 }
  }

  return null
}

function cefDevolutivaActivityExists_(dealId, ownerUserId, messageId, relation) {
  const response = cefDevolutivaCallPipedrive_('activities?deal_id=' + encodeURIComponent(String(dealId)) + '&done=0&limit=500', 'GET', null) || {}
  const activities = Array.isArray(response) ? response : (response.data || [])
  const typeConfig = cefDevolutivaGetActivityTypeConfig_(relation)
  for (let i = 0; i < activities.length; i++) {
    const activity = activities[i] || {}
    const subject = String(activity.subject || '').trim()
    const uid = cefDevolutivaExtractActivityUserId_(activity)
    const typeMatches = !typeConfig || cefDevolutivaActivityMatchesType_(activity, typeConfig.key)
    if (
      subject === CEF_DEVOLUTIVA_ACTIVITY_SUBJECT_ &&
      Number(uid) === Number(ownerUserId) &&
      typeMatches
    ) {
      return true
    }
  }
  return false
}

function cefDevolutivaActivityMatchesType_(activity, expectedTypeKey) {
  const wanted = cefDevolutivaNormalize_(expectedTypeKey)
  if (!wanted) return true
  const candidates = [
    activity && activity.type,
    activity && activity.type_key,
    activity && activity.type_name
  ]
  for (let i = 0; i < candidates.length; i++) {
    if (cefDevolutivaNormalize_(candidates[i]) === wanted) return true
  }
  return false
}

function cefDevolutivaBuildDealPatch_(relation) {
  const patch = {}
  if (relation === CEF_DEVOLUTIVA_REL_IPTU_) {
    patch[CEF_DEVOLUTIVA_STATUS_IPTU_FIELD_KEY_] = CEF_DEVOLUTIVA_STATUS_IPTU_PENDENCIA_ID_
    patch[CEF_DEVOLUTIVA_TAG_IPTU_KEY_] = CEF_DEVOLUTIVA_TAG_IPTU_ID_
