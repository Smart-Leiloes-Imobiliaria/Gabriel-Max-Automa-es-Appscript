}

function cefDevolutivaIsEmptyPipedriveValue_(value) {
  if (value == null) return true
  if (Array.isArray(value)) return value.length === 0
  if (typeof value === 'object') {
    if (Object.prototype.hasOwnProperty.call(value, 'value')) return cefDevolutivaIsEmptyPipedriveValue_(value.value)
    if (Object.prototype.hasOwnProperty.call(value, 'id')) return cefDevolutivaIsEmptyPipedriveValue_(value.id)
    return Object.keys(value).length === 0
  }
  return String(value || '').trim() === ''
}

function cefDevolutivaNormalizePipedriveDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return cefDevolutivaFormatDate_(value)
  if (cefDevolutivaIsEmptyPipedriveValue_(value)) return ''

  if (typeof value === 'object') {
    if (Object.prototype.hasOwnProperty.call(value, 'value')) return cefDevolutivaNormalizePipedriveDate_(value.value)
    if (Object.prototype.hasOwnProperty.call(value, 'date')) return cefDevolutivaNormalizePipedriveDate_(value.date)
  }

  const text = String(value || '').trim()
  const iso = text.match(/^(\d{4}-\d{2}-\d{2})/)
  if (iso) return iso[1]

  const br = text.match(/^(\d{2})\/(\d{2})\/(\d{4})/)
  if (br) return br[3] + '-' + br[2] + '-' + br[1]

  const parsed = new Date(text)
  if (!isNaN(parsed.getTime())) return cefDevolutivaFormatDate_(parsed)
  return ''
}

function cefDevolutivaGetMessageLabels_(message) {
  const thread = message.getThread()
  const labels = thread ? thread.getLabels() : []
  const out = []
  for (let i = 0; i < labels.length; i++) {
    out.push(String(labels[i].getName() || ''))
  }
  return out
}

function cefDevolutivaGetReadableBody_(message) {
  const plain = String(message && message.getPlainBody ? (message.getPlainBody() || '') : '')
  const html = String(message && message.getBody ? (message.getBody() || '') : '')
  const htmlText = cefDevolutivaHtmlToReadableText_(html)
  if (!htmlText || cefDevolutivaNormalize_(plain).indexOf(cefDevolutivaNormalize_(htmlText)) >= 0) return plain
  if (!plain) return htmlText
  return plain + '\n' + htmlText
}

function cefDevolutivaHtmlToReadableText_(html) {
  let text = String(html || '')
  if (!text) return ''

  text = text
    .replace(/<\s*br\s*\/?\s*>/gi, '\n')
    .replace(/<\s*\/\s*(p|div|h[1-6]|li|section|article)\s*>/gi, '\n')
    .replace(/<\s*\/\s*tr\s*>/gi, '\n')
    .replace(/<\s*\/\s*(td|th)\s*>/gi, '\t')
    .replace(/<\s*(tr|td|th)\b[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n[ \t]+/g, '\n')
    .replace(/[ \t]{2,}/g, ' ')
    .replace(/\n{3,}/g, '\n\n')
    .trim()

  return text
}

function cefDevolutivaBuildBodyDebug_(message, readableBody) {
  const plain = String(message && message.getPlainBody ? (message.getPlainBody() || '') : '')
  const html = String(message && message.getBody ? (message.getBody() || '') : '')
  const htmlText = cefDevolutivaHtmlToReadableText_(html)
  return {
    plainLength: plain.length,
    htmlLength: html.length,
    htmlTextLength: htmlText.length,
    readableLength: String(readableBody || '').length,
    readableSample: String(readableBody || '').slice(0, 1200)
  }
}

function cefDevolutivaExtractTipoDespesa_(body) {
  const text = String(body || '')
  const fromTable = cefDevolutivaExtractTableColumnValue_(text, 'tipo despesa')
  if (fromTable) return fromTable

  const sameLineMatch = text.match(/tipo\s+despesa\s*[:\-]\s*([^\n\r]+)/i)
  if (sameLineMatch) return String(sameLineMatch[1] || '').trim()

  const lines = text.split(/\r?\n/)
  for (let i = 0; i < lines.length; i++) {
    const current = cefDevolutivaNormalize_(lines[i]).replace(/[:\-]+$/g, '').trim()
    const next = i + 1 < lines.length ? cefDevolutivaNormalize_(lines[i + 1]).replace(/[:\-]+$/g, '').trim() : ''
    let valueStart = -1

    if (current === 'tipo despesa') valueStart = i + 1
    else if (current === 'tipo' && next === 'despesa') valueStart = i + 2
    if (valueStart < 0) continue

    const parts = []
    for (let j = valueStart; j < lines.length && parts.length < 4; j++) {
      const value = String(lines[j] || '').trim()
      if (!value) continue
      parts.push(value)
      const joined = parts.join(' ')
      if (cefDevolutivaClassifyExpenseText_(joined)) return joined
    }

    return parts.join(' ').trim()
  }

  return ''
}

function cefDevolutivaExtractTableColumnValue_(body, columnName) {
  const text = String(body || '')
  const wanted = cefDevolutivaNormalize_(columnName)
  if (wanted !== 'tipo despesa') return ''
  const tabular = cefDevolutivaExtractDelimitedTableColumnValue_(text, wanted)
  if (tabular) return tabular
  const plain = cefDevolutivaExtractPlainTextTableColumnValue_(text, wanted)
  if (plain) return plain
  return cefDevolutivaExtractStackedTableColumnValue_(text, wanted)
}

function cefDevolutivaExtractDelimitedTableColumnValue_(text, wanted) {
  const lines = String(text || '').split(/\r?\n/)
  for (let i = 0; i < lines.length - 1; i++) {
    if (lines[i].indexOf('\t') < 0) continue
    const headers = lines[i].split('\t').map(function (part) { return cefDevolutivaNormalize_(part) })
    const col = headers.indexOf(wanted)
    if (col < 0) continue

    for (let j = i + 1; j < lines.length; j++) {
      if (!String(lines[j] || '').trim()) continue
      const values = String(lines[j] || '').split('\t')
      if (values.length <= col) continue
      const value = String(values[col] || '').trim()
      if (cefDevolutivaIsTableHeaderLine_(lines[j]) || cefDevolutivaNormalize_(value) === wanted) continue
      if (value && wanted === 'tipo despesa') {
        const nextLine = j + 1 < lines.length ? String(lines[j + 1] || '').trim() : ''
        const nextPart = nextLine.indexOf('\t') >= 0 ? String(nextLine.split('\t')[0] || '').trim() : nextLine
        if (nextPart && !cefDevolutivaClassifyExpenseText_(value) && cefDevolutivaClassifyExpenseText_(value + ' ' + nextPart)) {
          return value + ' ' + nextPart
        }
      }
      if (value) return value
    }
  }
  return ''
}

function cefDevolutivaExtractPlainTextTableColumnValue_(text, wanted) {
  const lines = String(text || '').split(/\r?\n/)

  for (let i = 0; i < lines.length; i++) {
    if (!cefDevolutivaIsTableHeaderLine_(lines[i])) continue

    for (let j = i + 1; j < lines.length && j <= i + 12; j++) {
      const line = String(lines[j] || '').trim()
      if (!line || cefDevolutivaIsTableHeaderLine_(line)) continue

      const parsed = cefDevolutivaParsePlainTextExpenseRow_(line)
      if (!parsed) continue
      if (wanted === 'tipo despesa') return parsed.tipoDespesa
    }
  }

  return ''
}

function cefDevolutivaIsTableHeaderLine_(line) {
  const normalized = cefDevolutivaNormalize_(line)
  return normalized.indexOf('id imovel') >= 0 && normalized.indexOf('tipo despesa') >= 0
}

function cefDevolutivaParsePlainTextExpenseRow_(line) {
  const text = String(line || '').replace(/\s+/g, ' ').trim()
  const match = text.match(/^(\d+)\s+(\d{5,})\s+(.+?)\s+(Boleto|Pix|PIX|TED|DOC|Transfer[eê]ncia|Cart[aã]o)\b/i)
  if (!match) return null
  return {
    id: String(match[1] || '').trim(),
    imovel: String(match[2] || '').trim(),
    tipoDespesa: String(match[3] || '').trim()
  }
}

function cefDevolutivaExtractStackedTableColumnValue_(text, wanted) {
  const lines = String(text || '').split(/\r?\n/)
    .map(function (line) { return String(line || '').trim() })
    .filter(function (line) { return !!line })

  for (let i = 0; i < lines.length; i++) {
    const current = cefDevolutivaNormalize_(lines[i]).replace(/[:\-]+$/g, '').trim()
    const next = i + 1 < lines.length ? cefDevolutivaNormalize_(lines[i + 1]).replace(/[:\-]+$/g, '').trim() : ''
    let dataStart = -1
    let columnOffset = -1

    if (current === 'id' && next === 'imovel') {
      const header = cefDevolutivaReadStackedTableHeader_(lines, i)
      if (header.names.length && header.names.indexOf(wanted) >= 0) {
        dataStart = header.nextIndex
        columnOffset = header.names.indexOf(wanted)
      }
    }

    if (dataStart < 0 || columnOffset < 0) continue

    const value = cefDevolutivaReadStackedTableValue_(lines, dataStart, columnOffset, wanted)
    if (value) return value
  }

  return ''
}

function cefDevolutivaReadStackedTableHeader_(lines, start) {
  const names = []
  let i = start
  while (i < lines.length && names.length < 12) {
    const one = cefDevolutivaNormalize_(lines[i]).replace(/[:\-]+$/g, '').trim()
    const two = i + 1 < lines.length ? cefDevolutivaNormalize_(lines[i + 1]).replace(/[:\-]+$/g, '').trim() : ''

    if (one === 'tipo' && two === 'despesa') {
      names.push('tipo despesa')
      i += 2
    } else if (one === 'meio de' && two === 'pagamento') {
      names.push('meio de pagamento')
      i += 2
    } else if (one === 'comp' && two === 'inicial') {
      names.push('comp inicial')
      i += 2
    } else if (one === 'comp' && two === 'final') {
      names.push('comp final')
      i += 2
    } else {
      names.push(one)
      i++
    }

    if (names[names.length - 1].indexOf('motivo') >= 0) {
      if (names.indexOf('tipo despesa') >= 0 && names.indexOf('imovel') >= 0) break
    }
  }
  return { names: names, nextIndex: i }
}

function cefDevolutivaReadStackedTableValue_(lines, dataStart, columnOffset, wanted) {
  let index = dataStart + columnOffset
  if (index >= lines.length) return ''

  let value = String(lines[index] || '').trim()
  if (wanted === 'tipo despesa') {
    const next = index + 1 < lines.length ? String(lines[index + 1] || '').trim() : ''
    if (next && !cefDevolutivaClassifyExpenseText_(value) && cefDevolutivaClassifyExpenseText_(value + ' ' + next)) {
      value += ' ' + next
    }
  }

  return value
}

function cefDevolutivaExtractDespesa_(body) {
  const match = String(body || '').match(/(?:^|[\n\r])\s*despesa\s*[:\-]\s*([^\n\r]+)/i)
  return match ? String(match[1] || '').trim() : ''
}

function cefDevolutivaExtractAtesteExpenseInfo_(body) {
  const despesa = cefDevolutivaExtractDespesa_(body)
  if (despesa) return { value: despesa, source: 'despesa' }

  const tipoDespesa = cefDevolutivaExtractTipoDespesa_(body)
  if (tipoDespesa) return { value: tipoDespesa, source: 'tipo_despesa' }

  return { value: '', source: 'despesa' }
}

function cefDevolutivaClassifyExpenseText_(value) {
  const normalized = cefDevolutivaNormalize_(value)
  if (/\biptu\b/.test(normalized)) return CEF_DEVOLUTIVA_REL_IPTU_
  if (normalized.indexOf('taxa condominial') >= 0 || normalized.indexOf('condominio') >= 0) {
    return CEF_DEVOLUTIVA_REL_CONDOMINIO_
  }
  return ''
}

function cefDevolutivaGetDealFieldValue_(deal, fieldKey) {
  const key = String(fieldKey || '').trim()
  if (!deal || typeof deal !== 'object' || !key) return null
  if (Object.prototype.hasOwnProperty.call(deal, key)) return deal[key]
  const custom = deal.custom_fields && typeof deal.custom_fields === 'object' ? deal.custom_fields : null
  if (custom && Object.prototype.hasOwnProperty.call(custom, key)) return custom[key]
  return null
}

function cefDevolutivaExtractActivityUserId_(activity) {
  if (!activity) return 0
  const value = activity.user_id
  if (value && typeof value === 'object' && value.id) return Number(value.id) || 0
  if (value) return Number(value) || 0
  if (activity.assigned_to_user_id) return Number(activity.assigned_to_user_id) || 0
  if (activity.owner_id && typeof activity.owner_id === 'object' && activity.owner_id.id) return Number(activity.owner_id.id) || 0
  if (activity.owner_id) return Number(activity.owner_id) || 0
  return 0
}

function cefDevolutivaExtractActivityDealId_(activity) {
  if (!activity) return 0
  const value = activity.deal_id
  if (value && typeof value === 'object' && value.id) return Number(value.id) || 0
  if (value) return Number(value) || 0
  if (activity.deal && typeof activity.deal === 'object' && activity.deal.id) return Number(activity.deal.id) || 0
  if (activity.deal) return Number(activity.deal) || 0
  return 0
}

function cefDevolutivaWasProcessed_(messageId) {
  return PropertiesService.getScriptProperties().getProperty(CEF_DEVOLUTIVA_PROCESSED_PROP_PREFIX_ + messageId) === '1'
}

function cefDevolutivaWasProcessedMessage_(message) {
  if (CEF_DEVOLUTIVA_IGNORE_PROCESSED_FOR_TESTS_) return false
  const messageId = String(message && message.getId ? message.getId() : '').trim()
  return !!(messageId && cefDevolutivaWasProcessed_(messageId))
}

function cefDevolutivaMessageHasProcessedLabel_(message) {
  const labelNames = cefDevolutivaGetMessageLabels_(message)
  for (let i = 0; i < labelNames.length; i++) {
    if (String(labelNames[i] || '') === CEF_DEVOLUTIVA_PROCESSED_LABEL_) return true
  }
  return false
}

function cefDevolutivaMarkProcessed_(messageId, data, message, processedLabel) {
  const props = PropertiesService.getScriptProperties()
  props.setProperty(CEF_DEVOLUTIVA_PROCESSED_PROP_PREFIX_ + messageId, '1')
  props.setProperty(CEF_DEVOLUTIVA_PROCESSED_PROP_PREFIX_ + messageId + '_DATA', JSON.stringify(data || {}))
  cefDevolutivaMarkMessageProcessedLabel_(message, processedLabel)
}

function cefDevolutivaMarkMessageProcessedLabel_(message, processedLabel) {
  if (!message || !message.getThread) return
  const thread = message.getThread()
  if (!thread) return
  ;(processedLabel || cefDevolutivaGetProcessedLabel_()).addToThread(thread)
}

function cefDevolutivaGetProcessedLabel_() {
  return GmailApp.getUserLabelByName(CEF_DEVOLUTIVA_PROCESSED_LABEL_) || GmailApp.createLabel(CEF_DEVOLUTIVA_PROCESSED_LABEL_)
}

function cefDevolutivaMarkError_(messageId, error) {
