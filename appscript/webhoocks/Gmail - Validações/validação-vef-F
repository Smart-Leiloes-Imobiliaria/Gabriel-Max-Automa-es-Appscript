let CEF_DEVOLUTIVA_PIPEDRIVE_USERS_CACHE_ = null

function processarDevolutivasCefIptuCondominio() {
  const queries = cefDevolutivaBuildGmailQueries_()
  const summary = { scanned: 0, processed: 0, skipped: 0, errors: 0 }
  const seenMessages = {}

  cefDevolutivaScanLabelThreads_(function (message) {
    const result = processarMensagemDevolutivaCef_(message)
    if (result && result.ok && result.processed) summary.processed++
    else if (result && result.ok) summary.skipped++
    else summary.errors++
    summary.scanned++
  }, seenMessages, CEF_DEVOLUTIVA_MAX_THREADS_PER_RUN_)

  for (let q = 0; q < queries.length; q++) {
    const query = queries[q]
    for (let start = 0; start < CEF_DEVOLUTIVA_MAX_THREADS_PER_RUN_; start += CEF_DEVOLUTIVA_THREAD_PAGE_SIZE_) {
      const threads = GmailApp.search(query, start, CEF_DEVOLUTIVA_THREAD_PAGE_SIZE_)
      if (!threads.length) break

      for (let i = 0; i < threads.length; i++) {
        const messages = threads[i].getMessages()
        for (let j = 0; j < messages.length; j++) {
          const messageId = String(messages[j].getId() || '').trim()
          if (messageId && seenMessages[messageId]) continue
          if (messageId) seenMessages[messageId] = true
          summary.scanned++
          const result = processarMensagemDevolutivaCef_(messages[j])
          if (result && result.ok && result.processed) summary.processed++
          else if (result && result.ok) summary.skipped++
          else summary.errors++
        }
      }
    }
  }

  return summary
}

function cefDevolutivaBuildGmailQuery_() {
  return cefDevolutivaBuildGmailQueries_()[0]
}

function cefDevolutivaBuildGmailQueries_() {
  const dateFilter = CEF_DEVOLUTIVA_IGNORE_PROCESS_DATE_TEMP_
    ? ''
    : ' after:' + cefDevolutivaFormatGmailSearchDate_(cefDevolutivaAddDays_(CEF_DEVOLUTIVA_PROCESS_FROM_DATE_, -1))
  return [
    'subject:"Análise Documental ID:"',
    'subject:"Analise Documental ID:"',
    'subject:"ANÁLISE DOCUMENTAL"',
    'subject:"ANALISE DOCUMENTAL"',
    'subject:"Análise Documental"',
    'subject:"Analise Documental"',
    'subject:"Ateste de pagamento ID:"',
    'subject:"ATESTE DE PAGAMENTO"',
    'subject:"Ateste de pagamento"'
  ].map(function (query) {
    return query + dateFilter
  })
}

