function cefDevolutivaNormalize_(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .trim()
}

function cefDevolutivaNormalizeCode_(value) {
  return String(value == null ? '' : value).replace(/\D+/g, '').trim()
}

function cefDevolutivaAddBusinessDays_(date, days) {
  const out = new Date(date.getTime())
  let remaining = Math.max(0, Number(days || 0))

  while (remaining > 0) {
    out.setDate(out.getDate() + 1)
    const day = out.getDay()
    if (day !== 0 && day !== 6) remaining--
  }

  return out
}

function cefDevolutivaMessageIsFromProcessDate_(message) {
  return cefDevolutivaMessageIsAfterProcessDate_(message)
}

function cefDevolutivaMessageIsAfterProcessDate_(message) {
  if (CEF_DEVOLUTIVA_IGNORE_PROCESS_DATE_TEMP_) return true
  const receivedAt = message && message.getDate ? message.getDate() : null
  if (!(receivedAt instanceof Date) || isNaN(receivedAt.getTime())) return false
  return receivedAt.getTime() > cefDevolutivaEndOfDay_(CEF_DEVOLUTIVA_PROCESS_FROM_DATE_).getTime()
}

function cefDevolutivaAddDays_(date, days) {
  const out = new Date(date.getTime())
  out.setDate(out.getDate() + Number(days || 0))
  return out
}

function cefDevolutivaStartOfDay_(date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
}

function cefDevolutivaEndOfDay_(date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 23, 59, 59, 999)
}

function cefDevolutivaFormatGmailSearchDate_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone() || 'America/Sao_Paulo', 'yyyy/MM/dd')
}

function cefDevolutivaFormatDate_(date) {
  return Utilities.formatDate(date, Session.getScriptTimeZone() || 'America/Sao_Paulo', 'yyyy-MM-dd')
}

