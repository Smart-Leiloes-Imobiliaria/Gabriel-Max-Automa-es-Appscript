function testarFluxoUnificadoCefSimulado() {
  const renamedUser = { id: 101, name: 'Jessica Gomes | Gabriel Max | Davi', active_flag: true }
  const inactiveUser = { id: 102, name: 'Jessica Gomes', active_flag: false }
  const ambiguousUsers = [
    { id: 201, name: 'Jessica Gomes | Equipe A', active_flag: true },
    { id: 202, name: 'Jessica Gomes | Equipe B', active_flag: true }
  ]
  const resolvedRenamed = cefDevolutivaFindPipedriveUserInListByName_('Jessica Gomes', [inactiveUser, renamedUser])
  const resolvedAmbiguous = cefDevolutivaFindPipedriveUserInListByName_('Jessica Gomes', ambiguousUsers)
  const webhookResult = orquestraDevolutivaCefIptuCondominio({ id: 999 }, ['status'], {})

  const checks = [
    { name: 'ateste_com_id_e_bem', ok: cefDevolutivaHasAtestePagamentoSubject_('Ateste de pagamento ID: 1 - BEM: 2') === true },
    { name: 'ateste_sem_id', ok: cefDevolutivaHasAtestePagamentoSubject_('Ateste de pagamento - Imóvel: 2') === true },
    { name: 'analise_nao_e_ateste', ok: cefDevolutivaHasAtestePagamentoSubject_('Análise Documental ID: 1 - Imóvel: 2') === false },
    { name: 'usuario_renomeado', ok: !!resolvedRenamed && Number(resolvedRenamed.id) === 101 },
    { name: 'usuario_ambiguo_bloqueado', ok: resolvedAmbiguous === null },
    { name: 'webhook_nao_cria_atividade', ok: webhookResult.activityCreated === false && webhookResult.skipped === 'unified_gmail_canonical_source' },
    { name: 'tipo_iptu', ok: cefDevolutivaActivityMatchesType_({ type: 'condominio' }, 'condominio') === true },
    { name: 'tipo_condominio_separado', ok: cefDevolutivaActivityMatchesType_({ type: 'condominio1' }, 'condominio') === false }
  ]
  const failed = checks.filter(function (check) { return check.ok !== true })
  const result = { ok: failed.length === 0, total: checks.length, failed: failed, checks: checks }
  Logger.log(JSON.stringify(result, null, 2))
  return result
}
