function onFormSubmitDocsPendentes(e) {
  return formsDocsPendentesWithLock_(function() {
    const parsed = formsDocsPendentesParseFormSubmission_(e)
    const outcome = formsDocsPendentesProcessSubmission_(parsed)
    formsDocsPendentesLog_('forms_docs_pendentes', 'onFormSubmitDocsPendentes', 'SIM', {
      dealId: outcome.dealId,
      title: outcome.documentTypeRaw,
      fields: 'processamento concluido',
      patch: outcome
    })
    return outcome
  }, e)
}

function onFormSubmit(e) {
  return onFormSubmitDocsPendentes(e)
}

function instalarGatilhoFormsDocsPendentes(formOrSpreadsheetId) {
  const target = formsDocsPendentesResolveTriggerTarget_(formOrSpreadsheetId)

  removerGatilhoFormsDocsPendentes()
  const builder = ScriptApp.newTrigger('onFormSubmit')
  const trigger = (target.type === 'form' ? builder.forForm(target.form) : builder.forSpreadsheet(target.spreadsheet))
    .onFormSubmit()
    .create()

  return {
    ok: true,
    handler: 'onFormSubmit',
    targetType: target.type,
    targetId: target.id,
    targetName: target.name,
    triggerId: trigger && trigger.getUniqueId ? trigger.getUniqueId() : ''
  }
}

function formsDocsPendentesResolveTriggerTarget_(formOrSpreadsheetId) {
  const explicitId = String(formOrSpreadsheetId || '').trim()
  const props = PropertiesService.getScriptProperties()
  const candidateFormIds = [
    explicitId,
    props.getProperty('FORMS_DOCS_PENDENTES_FORM_ID'),
    props.getProperty('FORM_ID'),
    FORMS_DOCS_PENDENTES_FORM_ID_
  ].map(function(value) {
    return String(value || '').trim()
  }).filter(Boolean)

  for (let i = 0; i < candidateFormIds.length; i++) {
    try {
      const form = FormApp.openById(candidateFormIds[i])
      return {
        type: 'form',
        id: form.getId(),
        name: form.getTitle(),
        form: form
      }
    } catch (error) {}
  }

  const spreadsheet = formsDocsPendentesResolveTriggerSpreadsheet_(explicitId)
  return {
    type: 'spreadsheet',
    id: spreadsheet.getId(),
    name: spreadsheet.getName(),
    spreadsheet: spreadsheet
  }
}

function formsDocsPendentesResolveTriggerSpreadsheet_(spreadsheetId) {
  const explicitId = String(spreadsheetId || '').trim()
  if (explicitId) return SpreadsheetApp.openById(explicitId)

  const active = SpreadsheetApp.getActiveSpreadsheet()
  if (active) return active

  const props = PropertiesService.getScriptProperties()
  const candidateIds = [
    props.getProperty('FORM_RESPONSES_SPREADSHEET_ID'),
    props.getProperty('SHEET_ID'),
    props.getProperty('CONTAINER_SPREADSHEET_ID'),
    props.getProperty('LOG_SPREADSHEET_ID')
  ].map(function(value) {
    return String(value || '').trim()
  }).filter(Boolean)

  for (let i = 0; i < candidateIds.length; i++) {
    try {
      return SpreadsheetApp.openById(candidateIds[i])
    } catch (error) {}
  }

  throw new Error(
    'Planilha de respostas do Forms nao encontrada. Rode instalarGatilhoFormsDocsPendentes("ID_DA_PLANILHA") ' +
    'ou configure a Script Property FORM_RESPONSES_SPREADSHEET_ID.'
  )
}

function removerGatilhoFormsDocsPendentes() {
  let removed = 0
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction && trigger.getHandlerFunction() === 'onFormSubmit') {
      ScriptApp.deleteTrigger(trigger)
      removed++
    }
  })
  return { ok: true, removed: removed, handler: 'onFormSubmit' }
}

function diagnosticarGatilhoFormsDocsPendentes() {
  const triggers = ScriptApp.getProjectTriggers()
    .filter(function(trigger) {
      return trigger.getHandlerFunction && trigger.getHandlerFunction() === 'onFormSubmit'
    })
    .map(function(trigger) {
      return {
        handler: trigger.getHandlerFunction(),
        eventType: trigger.getEventType ? String(trigger.getEventType()) : '',
        sourceId: trigger.getTriggerSourceId ? String(trigger.getTriggerSourceId() || '') : '',
        uniqueId: trigger.getUniqueId ? String(trigger.getUniqueId() || '') : ''
      }
    })

  return {
    ok: triggers.length === 1,
    expectedHandler: 'onFormSubmit',
    triggerCount: triggers.length,
    triggers: triggers
  }
}

