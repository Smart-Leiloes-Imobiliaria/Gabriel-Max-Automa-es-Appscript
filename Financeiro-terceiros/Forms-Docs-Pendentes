function formsDocsPendentesProcessSubmission_(submission) {
  const deal = formsDocsPendentesGetDealById_(submission.dealId)
  const driveLink = formsDocsPendentesGetDealDriveLink_(deal)
  const rootFolder = formsDocsPendentesResolveDriveFolderFromLink_(driveLink)
  const destination = formsDocsPendentesResolveDestination_(submission.documentTypeRaw)
  const destinationInfo = formsDocsPendentesResolveDestinationFolder_(rootFolder, destination.destination)
  const destinationFolder = destinationInfo.folder
  const uploadResults = formsDocsPendentesProcessUploadedFiles_(submission, destinationFolder, destination)
  const activity = formsDocsPendentesEnsureVerificationActivity_(submission, destination, uploadResults, deal)

  return {
    ok: true,
    responseId: submission.responseId,
    propertyCode: submission.propertyCode,
    dealId: submission.dealId,
    documentTypeRaw: submission.documentTypeRaw,
    documentTypeSource: submission.documentTypeSource,
    destinationKey: destination.destination.key,
    destinationPath: destination.destination.path.join(' / '),
    rootFolderId: rootFolder.getId(),
    rootFolderUrl: rootFolder.getUrl(),
    destinationFallbackToRoot: !!destinationInfo.fallbackToRoot,
    destinationExpectedPath: destinationInfo.expectedPath,
    destinationFolderId: destinationFolder.getId(),
    destinationFolderUrl: destinationFolder.getUrl(),
    files: uploadResults,
    activity: activity
  }
}

function formsDocsPendentesParseFormSubmission_(e) {
  if (!e) throw formsDocsPendentesError_('Evento do Forms invalido.', {})

  if (e.response && typeof e.response.getItemResponses === 'function') {
    const itemResponses = e.response.getItemResponses()
    const headers = []
    const row = []
    itemResponses.forEach(function(itemResponse) {
      const item = itemResponse.getItem ? itemResponse.getItem() : null
      headers.push(item && item.getTitle ? item.getTitle() : '')
      row.push(formsDocsPendentesNormalizeFormResponseAnswer_(itemResponse.getResponse()))
    })
    return formsDocsPendentesParseRow_(headers, row, {
      responseId: formsDocsPendentesExtractResponseId_(e),
      rowNumber: 0,
      sheetName: '',
      source: 'form_response'
    })
  }

  if (e.range && e.range.getSheet && typeof e.range.getRow === 'function') {
    const sheet = e.range.getSheet()
    const rowNumber = Number(e.range.getRow() || 0)
    if (rowNumber < 2) throw formsDocsPendentesError_('Evento do Forms invalido: linha de cabecalho.', { rowNumber: rowNumber })
    const lastColumn = Math.max(sheet.getLastColumn(), e.range.getLastColumn ? e.range.getLastColumn() : 0)
    const headers = sheet.getRange(1, 1, 1, lastColumn).getValues()[0]
    const row = sheet.getRange(rowNumber, 1, 1, lastColumn).getValues()[0]
    return formsDocsPendentesParseRow_(headers, row, {
      responseId: formsDocsPendentesExtractResponseId_(e),
      rowNumber: rowNumber,
      sheetName: sheet.getName()
    })
  }

  if (e.namedValues && typeof e.namedValues === 'object') {
    const headers = Object.keys(e.namedValues)
    const row = headers.map(function(key) {
      const value = e.namedValues[key]
      return Array.isArray(value) ? value.join(', ') : value
    })
    return formsDocsPendentesParseRow_(headers, row, {
      responseId: formsDocsPendentesExtractResponseId_(e),
      rowNumber: 0,
      sheetName: ''
    })
  }

  throw formsDocsPendentesError_('Evento do Forms invalido: estrutura nao suportada.', {})
}

function formsDocsPendentesNormalizeFormResponseAnswer_(value) {
  if (Array.isArray(value)) {
    return value.map(function(item) {
      return String(item || '').trim()
    }).filter(Boolean).join(', ')
  }
  return String(value || '').trim()
}

function formsDocsPendentesParseRow_(headers, row, metadata) {
  const uploadInfo = formsDocsPendentesDetectUploadColumn_(headers, row)
  const propertyCode = formsDocsPendentesExtractPropertyCode_(headers, row)
  const dealLink = formsDocsPendentesExtractDealLink_(headers, row)
  const dealId = formsDocsPendentesExtractDealId_(dealLink)
  const documentTypeInfo = formsDocsPendentesResolveDocumentTypeFromRow_(headers, row, uploadInfo.index)
  const partnerName = formsDocsPendentesExtractPartnerName_(headers, row)
  const reason = formsDocsPendentesExtractReason_(headers, row)
  const fileIds = formsDocsPendentesExtractDriveFileRefs_(uploadInfo.value)

  if (!fileIds.length) {
    throw formsDocsPendentesError_('Arquivo nao encontrado na resposta do Forms.', {
      propertyCode: propertyCode,
      dealId: dealId,
      responseId: metadata && metadata.responseId
    })
  }

  return {
    responseId: metadata && metadata.responseId || formsDocsPendentesBuildFallbackResponseId_(row),
    rowNumber: metadata && metadata.rowNumber || 0,
    sheetName: metadata && metadata.sheetName || '',
    propertyCode: propertyCode,
    dealLink: dealLink,
    dealId: dealId,
    uploadIndex: uploadInfo.index,
    uploadRawValue: uploadInfo.value,
    documentTypeRaw: documentTypeInfo.value,
    documentTypeSource: documentTypeInfo.source,
    partnerName: partnerName,
    reason: reason,
    fileIds: fileIds,
    headers: headers,
    row: row
  }
}

