function registerWebhookDaviDealAutomation_(eventContext, name, automationFn, triggersFn, outputsFn) {
  if (typeof automationFn !== 'function') return

  const triggers = typeof triggersFn === 'function' ? triggersFn() : []
  const outputs = typeof outputsFn === 'function' ? outputsFn() : []
  const events = ['added.deal'].concat(WebhookDavi.Events.updatedDealFields(triggers))

  WebhookDavi.Events.setEvent(eventContext, events, function(data, validate) {
    return $(automationFn)(data.deal, data.changedKeys, data.options)
  }, {
    name: name,
    triggers: triggers,
    outputs: outputs
  })
}

