const WEBHOOK_DAVI_SERVICE_NAME_ = 'Webhooks | Financeiro Terceiros'
const TEST_DEAL_IDS_ = []
const DEBUG_LOG_WEBHOOK_RECEIVED_ = false
const RAW_LOG_TRUNCATE_ = 2500

function shouldLogRawWebhookPayload_() {
  if (typeof getWebhookVerboseLogEnabled_ === 'function') return getWebhookVerboseLogEnabled_()
  return DEBUG_LOG_WEBHOOK_RECEIVED_
}

function shouldLogWebhookDiagnosticEntries_() {
  if (typeof getWebhookVerboseLogEnabled_ === 'function') return getWebhookVerboseLogEnabled_()
  return false
}

function buildWebhookEventFingerprint_(event) {
  let raw = ''
  try { raw = JSON.stringify(event || {}) } catch (_) { raw = String(event || '') }
  if (!raw) return ''

  if (typeof stableHash32Text_ === 'function') {
    return String(stableHash32Text_(raw))
  }

  let hash = 0
  for (let i = 0; i < raw.length; i++) {
    hash = (hash * 31 + raw.charCodeAt(i)) >>> 0
  }
  return String(hash)
}

function webhookEventSeenRecently_(fingerprint) {
  const key = String(fingerprint || '').trim()
  if (!key) return false
  return !!CacheService.getScriptCache().get('WEBHOOK_EVENT_' + key)
}

function markWebhookEventSeen_(fingerprint) {
  const key = String(fingerprint || '').trim()
  if (!key) return
  const ttl = typeof getWebhookEventDedupTtlSeconds_ === 'function' ? getWebhookEventDedupTtlSeconds_() : 180
  CacheService.getScriptCache().put('WEBHOOK_EVENT_' + key, String(Date.now()), ttl)
}

function appendWebhookDecisionLog_(timestamp, norm, altered, fields, patch, changedKeys) {
  if (String(altered || '').trim().toUpperCase() === 'SKIP' && !shouldLogWebhookDiagnosticEntries_()) {
    return
  }

  appendLog_({
    timestamp: timestamp || new Date(),
    dealId: norm && norm.dealId ? norm.dealId : '',
    title: norm && norm.title ? norm.title : '',
    action: norm && norm.action ? norm.action : '',
    fn: 'webhook_event',
    altered: altered,
    fields: fields,
    patch: patch,
    changedKeys: Array.isArray(changedKeys) ? changedKeys : []
  })
}

function applyPatchedFieldsToDeal_(deal, patch) {
  var target = deal && typeof deal === 'object' ? deal : {}
  var source = patch && typeof patch === 'object' ? patch : {}
  var keys = Object.keys(source)

  if (!target.custom_fields || typeof target.custom_fields !== 'object') {
    target.custom_fields = {}
  }

  for (var i = 0; i < keys.length; i++) {
    var key = String(keys[i] || '').trim()
    if (!key) continue
    target[key] = source[key]
    target.custom_fields[key] = source[key]
  }

  return target
}

