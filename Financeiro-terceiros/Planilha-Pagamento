function enviarValoresPagamentoMensalParceirosParaPipedrive() {
  const startedAt = new Date()
  const sheet = planilhaPagGetSheet_()
  const lastRow = sheet.getLastRow()
  const totalLinhas = Math.max(lastRow - 1, 0)
  const resumo = planilhaPagCriarResumoEnvio_(totalLinhas)

  Logger.log('[Planilha-Pag] Início do envio ao Pipedrive.')
  Logger.log('[Planilha-Pag] Linhas analisadas: ' + totalLinhas)

  if (lastRow < 2) {
    Logger.log('[Planilha-Pag] Nenhuma linha de dados encontrada para envio.')
    planilhaPagRegistrarResumoEnvio_(startedAt, resumo)
    return resumo
  }

  const logSheet = planilhaPagGetLogSheet_()
  const sucessosAnteriores = planilhaPagCarregarUltimosSucessos_(logSheet)
  const linhas = sheet.getRange(2, PLANILHA_PAG_TOTAL_COLUMN_, totalLinhas, 2).getValues()
  const pendentes = []
  const valoresJaAgendados = {}

  linhas.forEach(function (rowValues, index) {
    const linha = index + 2
    const valorRaw = rowValues[0]
    const dealId = planilhaPagLimparValor_(rowValues[1])
    const valor = planilhaPagParseValorMonetario_(valorRaw)

    if (!dealId) {
      planilhaPagRegistrarIgnorado_(resumo, linha, dealId, valorRaw, 'ID vazio na coluna T.')
      return
    }

    if (!valor || valor <= 0) {
      planilhaPagRegistrarIgnorado_(resumo, linha, dealId, valorRaw, 'TOTAL vazio, inválido ou zero na coluna S.')
      return
    }

    if (
      sucessosAnteriores[dealId] &&
      planilhaPagValoresIguais_(sucessosAnteriores[dealId].valorEnviado, valor)
    ) {
      planilhaPagRegistrarIgnorado_(
        resumo,
        linha,
        dealId,
        valor,
        'Já atualizado com sucesso anteriormente com o mesmo valor.'
      )
      return
    }

    if (
      valoresJaAgendados[dealId] !== undefined &&
      planilhaPagValoresIguais_(valoresJaAgendados[dealId], valor)
    ) {
      planilhaPagRegistrarIgnorado_(
        resumo,
        linha,
        dealId,
        valor,
        'Duplicado na execução atual com o mesmo ID e valor.'
      )
      return
    }

    resumo.elegiveis++
    valoresJaAgendados[dealId] = valor
    pendentes.push({ linha: linha, dealId: dealId, valorEnviado: valor })
  })

  const primeiraRodada = planilhaPagProcessarAtualizacoes_(pendentes, false, logSheet, resumo)
  if (primeiraRodada.erros.length) {
    Logger.log('[Planilha-Pag] Iniciando retentativa para erros: ' + primeiraRodada.erros.length)
    planilhaPagProcessarAtualizacoes_(primeiraRodada.erros, true, logSheet, resumo)
  }

  resumo.duracaoMs = new Date().getTime() - startedAt.getTime()
  planilhaPagRegistrarResumoEnvio_(startedAt, resumo)
  Logger.log('[Planilha-Pag] Resumo final envio: ' + JSON.stringify(resumo))
  return resumo
}

function testarEnvioPagamentoMensalParceiroLinha(linha) {
  const startedAt = new Date()
  const numeroLinha = Number(linha || 0)
  if (!numeroLinha || numeroLinha < 2) throw new Error('Informe uma linha válida maior ou igual a 2.')

  const sheet = planilhaPagGetSheet_()
  const values = sheet.getRange(numeroLinha, PLANILHA_PAG_TOTAL_COLUMN_, 1, 2).getValues()[0]
  const valor = planilhaPagParseValorMonetario_(values[0])
  const dealId = planilhaPagLimparValor_(values[1])
  const resultado = {
    linha: numeroLinha,
    dealId: dealId,
    valorEnviado: valor || 0,
    sucesso: false,
    erro: ''
  }

  if (!dealId) {
    resultado.erro = 'ID vazio na coluna T.'
    planilhaPagRegistrarLogEnvio_(planilhaPagGetLogSheet_(), resultado, 'erro', false, resultado.erro)
    planilhaPagRegistrarResumoEnvio_(startedAt, planilhaPagCriarResumoTesteEnvio_(resultado))
    return resultado
  }

  if (!valor || valor <= 0) {
    resultado.erro = 'TOTAL vazio, inválido ou zero na coluna S.'
    planilhaPagRegistrarLogEnvio_(planilhaPagGetLogSheet_(), resultado, 'erro', false, resultado.erro)
    planilhaPagRegistrarResumoEnvio_(startedAt, planilhaPagCriarResumoTesteEnvio_(resultado))
    return resultado
  }

  try {
    planilhaPagAtualizarValorDeal_(dealId, valor)
    resultado.sucesso = true
    planilhaPagRegistrarLogEnvio_(planilhaPagGetLogSheet_(), resultado, 'sucesso', false, '')
  } catch (err) {
    resultado.erro = planilhaPagErro_(err)
    planilhaPagRegistrarLogEnvio_(planilhaPagGetLogSheet_(), resultado, 'erro', false, resultado.erro)
  }

  planilhaPagRegistrarResumoEnvio_(startedAt, planilhaPagCriarResumoTesteEnvio_(resultado))
  Logger.log('[Planilha-Pag] Resultado teste linha ' + numeroLinha + ': ' + JSON.stringify(resultado))
  return resultado
}

function testarEnvioPagamentoMensalParceiroLinhaManual() {
  const linhaParaTeste = 10
  return testarEnvioPagamentoMensalParceiroLinha(linhaParaTeste)
