function exportarFiltroPipedriveParaPlanilha(filterId) {
  const resolvedFilterId = Number(filterId || planilhaPagGetDefaultFilterId_())
  const startedAt = new Date()
  Logger.log('[Planilha-Pag] Início da execução. filter_id=' + resolvedFilterId)

  try {
    const filtro = obterFiltroPipedrive(resolvedFilterId)
    planilhaPagLogFiltro_(filtro)

    const dados = buscarFiltroPipedrive(resolvedFilterId)
    Logger.log('[Planilha-Pag] Quantidade de registros encontrados: ' + dados.length)
    if (dados.length) {
      Logger.log('[Planilha-Pag] Primeiro registro: id=' + planilhaPagExtrairDealId_(dados[0]))
    }

    const indiceCampos = buscarIndiceCamposPipedrive()
    const dadosMapeados = mapearDadosPipedrive(dados, indiceCampos)
    const dadosRelacionados = relacionarUsuarios(dadosMapeados)
    const values = montarValuesSheets(dadosRelacionados)

    Logger.log('[Planilha-Pag] Campos mapeados: ' + PLANILHA_PAG_HEADERS_.join(' | '))
    Logger.log('[Planilha-Pag] Quantidade de linhas geradas: ' + values.length)

    escreverNaPlanilha(values)

    Logger.log('[Planilha-Pag] Execução finalizada em ms: ' + (new Date().getTime() - startedAt.getTime()))
    return values
  } catch (err) {
    Logger.log('[Planilha-Pag] Erro na execução: ' + planilhaPagErro_(err))
    throw err
  }
}

function exportarFiltro35331ParaPlanilha() {
  return exportarFiltroPipedriveParaPlanilha(planilhaPagGetDefaultFilterId_())
}

