function planilhaPagCriarResumoEnvio_(totalLinhas) {
  return {
    totalLinhasAnalisadas: totalLinhas,
    elegiveis: 0,
    atualizados: 0,
    ignorados: 0,
    erros: 0,
    idsEnviados: [],
    valoresEnviados: [],
    naoAtualizados: [],
    primeiraTentativa: { sucesso: 0, erro: 0 },
    retentativa: { sucesso: 0, erro: 0 },
    duracaoMs: 0
  }
}

function planilhaPagCriarResumoTesteEnvio_(resultado) {
  return {
    atualizados: resultado && resultado.sucesso ? 1 : 0
  }
}

function planilhaPagProcessarAtualizacoes_(itens, retentativa, logSheet, resumo) {
  const erros = []
  const lista = Array.isArray(itens) ? itens : []

  for (let i = 0; i < lista.length; i++) {
    const item = lista[i]
    try {
      planilhaPagAtualizarValorDeal_(item.dealId, item.valorEnviado)
      resumo.atualizados++
      resumo.idsEnviados.push(item.dealId)
      resumo.valoresEnviados.push(item.valorEnviado)
      if (retentativa) resumo.retentativa.sucesso++
      else resumo.primeiraTentativa.sucesso++

      if (logSheet) {
        planilhaPagRegistrarLogEnvio_(logSheet, item, 'sucesso', retentativa, '')
      }
      Logger.log(
        '[Planilha-Pag] Atualizado: linha=' + item.linha +
        ' | dealId=' + item.dealId +
        ' | valor=' + item.valorEnviado +
        ' | retentativa=' + retentativa
      )
    } catch (err) {
      const erro = planilhaPagErro_(err)
      const erroItem = {
        linha: item.linha,
        dealId: item.dealId,
        valorEnviado: item.valorEnviado,
        erro: erro
      }
      erros.push(erroItem)

      if (retentativa) {
        resumo.erros++
        resumo.retentativa.erro++
        resumo.naoAtualizados.push({
          linha: item.linha,
          dealId: item.dealId,
          valorEnviado: item.valorEnviado,
          motivo: 'Retentativa falhou: ' + erro
        })
      } else {
        resumo.primeiraTentativa.erro++
      }

      if (logSheet) {
        planilhaPagRegistrarLogEnvio_(logSheet, erroItem, 'erro', retentativa, erro)
      }
      Logger.log(
        '[Planilha-Pag] Erro ao atualizar: linha=' + item.linha +
        ' | dealId=' + item.dealId +
        ' | valor=' + item.valorEnviado +
        ' | retentativa=' + retentativa +
        ' | erro=' + erro
      )
    }

    if ((i + 1) % PLANILHA_PAG_UPDATE_BATCH_SIZE_ === 0 && i + 1 < lista.length) {
      Logger.log('[Planilha-Pag] Lote de ' + PLANILHA_PAG_UPDATE_BATCH_SIZE_ + ' concluído. Pausa de 2 segundos.')
      Utilities.sleep(PLANILHA_PAG_UPDATE_BATCH_SLEEP_MS_)
    }
  }

  return { erros: erros }
}

function planilhaPagAtualizarValorDeal_(dealId, valorTotal) {
  const paymentFieldKey = planilhaPagGetPaymentFieldKey_()
  const payload = {}
  payload[paymentFieldKey] = valorTotal
  return planilhaPagCallPipedrive_('deals/' + encodeURIComponent(String(dealId)), 'PUT', payload)
}

function planilhaPagRegistrarIgnorado_(resumo, linha, dealId, valor, motivo) {
  resumo.ignorados++
  resumo.naoAtualizados.push({
    linha: linha,
    dealId: dealId || '',
    valorEnviado: valor,
    motivo: motivo
  })
  Logger.log(
    '[Planilha-Pag] Linha ignorada: linha=' + linha +
    ' | dealId=' + String(dealId || '') +
    ' | valor=' + String(valor == null ? '' : valor) +
    ' | motivo=' + motivo
  )
}

function planilhaPagGetLogSheet_() {
  const ss = planilhaPagGetSpreadsheet_()
  const sheet = ss.getSheetByName(PLANILHA_PAG_LOG_SHEET_NAME_) || ss.insertSheet(PLANILHA_PAG_LOG_SHEET_NAME_)
  const headers = ['Data/hora', 'Linha', 'ID do imóvel', 'Valor enviado', 'Status', 'Retentativa', 'Mensagem']

  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers])
  }

  return sheet
}

